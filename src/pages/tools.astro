---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const sections = [
	{
		title: "站内工具",
		description: "围绕阅读、检索与内容维护的快捷入口。",
		items: [
			{ name: "全文搜索", description: "使用 Pagefind 在全部文章中快速定位关键词。", icon: "material-symbols:search-rounded", url: "/search/", tags: ["Pagefind", "站内"], accent: "#38bdf8" },
			{ name: "文章归档", description: "按年份浏览苍蓝回廊中已经发布的全部文章。", icon: "material-symbols:inventory-2-rounded", url: "/archive/", tags: ["文章", "时间线"], accent: "#818cf8" },
			{ name: "内容后台", description: "通过安全认证后编辑文章、动态与站点资料。", icon: "material-symbols:edit-document-rounded", url: "/admin/", tags: ["Decap CMS", "维护"], accent: "#2dd4bf" },
			{ name: "RSS 订阅", description: "在你喜欢的阅读器中持续接收博客更新。", icon: "material-symbols:rss-feed-rounded", url: "/rss.xml", tags: ["RSS", "订阅"], accent: "#fb923c" },
		],
	},
	{
		title: "研究与写作",
		description: "我常用的论文阅读、知识管理与开发工具。",
		items: [
			{ name: "arXiv", description: "开放获取的预印本平台，用于追踪计算机视觉与人工智能论文。", icon: "material-symbols:article", url: "https://arxiv.org/", tags: ["论文", "Research"], accent: "#ef4444" },
			{ name: "Papers with Code", description: "连接论文、代码与基准结果，便于复现实验和比较方法。", icon: "material-symbols:data-object-rounded", url: "https://paperswithcode.com/", tags: ["代码", "Benchmark"], accent: "#22c55e" },
			{ name: "Obsidian", description: "用本地 Markdown 组织论文笔记、概念关系与长期写作素材。", icon: "material-symbols:book-2-rounded", url: "https://obsidian.md/", tags: ["笔记", "Markdown"], accent: "#a855f7" },
			{ name: "Visual Studio Code", description: "用于代码、实验配置与博客内容维护的主要编辑器。", icon: "material-symbols:code-blocks-rounded", url: "https://code.visualstudio.com/", tags: ["开发", "编辑器"], accent: "#3b82f6" },
			{ name: "GitHub", description: "托管苍蓝回廊源码，也记录公开项目与学习过程。", icon: "simple-icons:github", url: "https://github.com/slowayyyyy", tags: ["开源", "Git"], accent: "#64748b" },
		],
	},
];

const count = sections.reduce((total, section) => total + section.items.length, 0);
---

<MainGridLayout title="工具" description="阅读、研究与写作的常用入口">
	<section class="tools-shell card-base z-10 px-7 py-7 relative w-full onload-animation">
		<header class="tools-hero">
			<div>
				<p class="tools-kicker">TOOLBOX / JAY ZHU</p>
				<h1>工具箱</h1>
				<p>把常用入口放在顺手的位置，让注意力留给阅读、实验和写作。</p>
			</div>
			<div class="tools-stat"><strong>{count}</strong><span>个入口</span></div>
		</header>

		<div class="tools-sections">
			{sections.map((section) => (
				<section class="tools-section">
					<div class="tools-heading">
						<div><h2>{section.title}</h2><p>{section.description}</p></div>
						<span>{section.items.length.toString().padStart(2, "0")}</span>
					</div>
					<div class="tools-grid">
						{section.items.map((item) => (
							<a class="tool-card" href={item.url} target={item.url.startsWith("http") ? "_blank" : undefined} rel={item.url.startsWith("http") ? "noopener noreferrer" : undefined} style={`--tool-accent:${item.accent}`}>
								<div class="tool-top">
									<span class="tool-icon"><Icon is:inline name={item.icon} /></span>
									<Icon is:inline class="tool-arrow" name="material-symbols:north-east-rounded" />
								</div>
								<h3>{item.name}</h3>
								<p>{item.description}</p>
								<div class="tool-tags">{item.tags.map((tag) => <span>{tag}</span>)}</div>
							</a>
						))}
					</div>
				</section>
			))}
		</div>
	</section>
</MainGridLayout>

<style>
	.tools-shell { overflow: hidden; }
	.tools-hero { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 1rem; padding: .4rem 0 1.5rem; border-bottom: 1px solid var(--line-divider); }
	.tools-kicker { margin: 0 0 .25rem; color: var(--primary); font-size: .68rem; font-weight: 850; letter-spacing: .14em; }
	.tools-hero h1 { margin: 0; color: var(--content-regular); font-size: clamp(1.55rem,3vw,2.1rem); }
	.tools-hero p:last-child { max-width: 38rem; margin: .4rem 0 0; color: var(--content-meta); font-size: .88rem; line-height: 1.7; }
	.tools-stat { display: grid; min-width: 5.4rem; padding: .7rem .85rem; border: 1px solid color-mix(in srgb,var(--primary) 22%,transparent); border-radius: 1rem; text-align: right; background: color-mix(in srgb,var(--primary) 7%,transparent); }
	.tools-stat strong { color: var(--primary); font-size: 1.5rem; line-height: 1; }
	.tools-stat span { margin-top: .2rem; color: var(--content-meta); font-size: .68rem; }
	.tools-sections { display: grid; gap: 2rem; padding-top: 1.6rem; }
	.tools-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: .9rem; }
	.tools-heading h2 { margin: 0; color: var(--content-regular); font-size: 1.12rem; }
	.tools-heading p { margin: .25rem 0 0; color: var(--content-meta); font-size: .78rem; }
	.tools-heading > span { color: color-mix(in srgb,var(--primary) 65%,var(--content-meta)); font-size: 1.3rem; font-weight: 850; opacity: .55; }
	.tools-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .85rem; }
	.tool-card { position: relative; display: flex; min-height: 12rem; flex-direction: column; padding: 1.05rem; overflow: hidden; border: 1px solid var(--line-divider); border-radius: 1.05rem; color: inherit; text-decoration: none; background: linear-gradient(145deg,color-mix(in srgb,var(--tool-accent) 7%,var(--card-bg)),var(--card-bg)); transition: transform .28s ease,border-color .28s ease,box-shadow .28s ease; }
	.tool-card::after { content:""; position:absolute; right:-2rem; bottom:-3rem; width:7rem; height:7rem; border-radius:50%; background:var(--tool-accent); opacity:.06; }
	.tool-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb,var(--tool-accent) 45%,var(--line-divider)); box-shadow: 0 .9rem 2rem color-mix(in srgb,var(--tool-accent) 10%,transparent); }
	.tool-top { display:flex; justify-content:space-between; align-items:center; }
	.tool-icon { width:2.7rem; height:2.7rem; display:grid; place-items:center; border-radius:.85rem; color:var(--tool-accent); background:color-mix(in srgb,var(--tool-accent) 12%,var(--card-bg)); font-size:1.35rem; }
	.tool-arrow { color:var(--content-meta); transition:transform .25s ease,color .25s ease; }
	.tool-card:hover .tool-arrow { color:var(--tool-accent); transform:translate(.15rem,-.15rem); }
	.tool-card h3 { margin:.85rem 0 .32rem; color:var(--content-regular); font-size:1rem; }
	.tool-card > p { margin:0; flex:1; color:var(--content-meta); font-size:.8rem; line-height:1.65; }
	.tool-tags { display:flex; flex-wrap:wrap; gap:.35rem; margin-top:.8rem; padding-top:.7rem; border-top:1px dashed var(--line-divider); }
	.tool-tags span { padding:.2rem .45rem; border-radius:999px; color:color-mix(in srgb,var(--tool-accent) 75%,var(--content-regular)); background:color-mix(in srgb,var(--tool-accent) 9%,transparent); font-size:.64rem; font-weight:750; }
	@media(max-width:640px){.tools-shell{padding:1.15rem}.tools-grid{grid-template-columns:1fr}.tools-stat{display:none}.tool-card{min-height:10.8rem}.tools-hero{grid-template-columns:1fr}}
</style>
