---
import DailyCheckins from '../components/DailyCheckins.astro';
import { siteConfig } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getAllCheckins } from '../lib/content';

const checkins = await getAllCheckins();
const checkinCopy = siteConfig.checkinSettings?.copy;
const pageTitle = checkinCopy?.pageTitle?.zh ?? '灯火计划';
const pageDescription =
	checkinCopy?.pageIntro?.zh ?? '用灯火日历记录每天的行动，查看每周目标和长期积累。';
---

<SiteLayout
	title={`${pageTitle} · 每日打卡 | ${siteConfig.name}`}
	description={pageDescription}
	pathname="/checkins/"
>
	<div class="checkins-page">
		<DailyCheckins checkins={checkins} />
	</div>
</SiteLayout>

<style>
	.checkins-page {
		padding: 0 0 2rem;
	}

	@media (max-width: 680px) {
		.checkins-page {
			padding-top: 0;
		}
	}
</style>
