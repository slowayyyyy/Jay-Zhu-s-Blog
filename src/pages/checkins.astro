---
import DailyCheckins from '../components/DailyCheckins.astro';
import { siteConfig } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getAllCheckins } from '../lib/content';

const checkins = await getAllCheckins();
---

<SiteLayout
	title={`灯火计划 · 每日打卡 | ${siteConfig.name}`}
	description="用灯火日历记录英语学习与运动锻炼，查看每周目标和长期积累。"
	pathname="/checkins/"
>
	<div class="checkins-page">
		<DailyCheckins checkins={checkins} />
	</div>
</SiteLayout>

<style>
	.checkins-page {
		padding: 0 0 2rem;
	}

	@media (max-width: 680px) {
		.checkins-page {
			padding-top: 0;
		}
	}
</style>
