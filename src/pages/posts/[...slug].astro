---
import PageViewCounter from '../../components/PageViewCounter.astro';
import PostCard from '../../components/PostCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { renderPostMarkdown } from '../../lib/markdown';
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
	estimateReadingMinutes,
	formatDate,
	getAllPosts,
	getPostSlug,
	getSectionInfo,
	getTagLabel,
	getTagMap,
} from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((post) => ({
		params: { slug: getPostSlug(post) },
		props: { post },
	}));
}

const { post } = Astro.props;
const renderedPost = await renderPostMarkdown(post.body ?? '', post.data);
const articleHtml = renderedPost.code;
const headings = renderedPost.metadata.headings;
const slug = getPostSlug(post);
const relatedPosts = (await getAllPosts())
	.filter(
		(item) =>
			item.id !== post.id &&
			item.data.tags.some((tag) => post.data.tags.includes(tag)),
	)
	.slice(0, 3);
const section = getSectionInfo(post.data.section);
const readingMinutes = estimateReadingMinutes(post);
const tagMap = await getTagMap();
---

<SiteLayout pathname={`/posts/${slug}/`} title={`${post.data.title} | Jay Zhu's Blog`} description={post.data.description}>
	<section class="container article-shell">
		<header class="article-head">
			<a class="section-chip article-section" href={`/search/?section=${post.data.section}`} style={`--chip-accent:${section.accent};`}>
				<span data-copy={`section.${post.data.section}`}>{section.zh}</span>
			</a>
			<h1>{post.data.title}</h1>
			<p>{post.data.description}</p>
			<div class="article-meta">
				<div>
					<span data-copy="article.published" />
					<strong>{formatDate(post.data.publishDate)}</strong>
				</div>
				{
					post.data.updatedDate && (
						<div>
							<span data-copy="article.updated" />
							<strong>{formatDate(post.data.updatedDate)}</strong>
						</div>
					)
				}
				<div>
					<span>Reading</span>
					<strong>{readingMinutes} min</strong>
				</div>
				<PageViewCounter pageId={`/posts/${slug}/`} />
			</div>
			<div class="article-tags">
				{post.data.tags.map((tag) => <a class="tag-chip" href={`/search/?tag=${encodeURIComponent(tag)}`}>#{getTagLabel(tag, tagMap)}</a>)}
			</div>
		</header>

		<div class="article-layout">
			<div class="article-aside">
				<TableOfContents headings={headings} />
			</div>
			<article class="article-body prose" set:html={articleHtml} />
		</div>

		{
			relatedPosts.length > 0 && (
				<section class="related-posts" aria-labelledby="related-title">
					<h2 id="related-title" data-copy="article.related" />
					<div class="related-grid">
						{relatedPosts.map((related) => <PostCard post={related} headingLevel="h3" />)}
					</div>
				</section>
			)
		}
	</section>
</SiteLayout>

<style>
	.article-shell {
		padding: clamp(3.5rem, 7vw, 6rem) 0 4rem;
	}

	.article-head {
		padding: 0 0 clamp(2rem, 5vw, 3.5rem);
		border-bottom: 1px solid var(--line);
	}

	.article-section {
		position: relative;
		min-height: 2.75rem;
		padding: 0 0 0 0.8rem;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: color-mix(in srgb, var(--chip-accent) 78%, var(--text));
	}

	.article-section::before {
		content: '';
		position: absolute;
		top: 0.8rem;
		bottom: 0.8rem;
		left: 0;
		width: 1px;
		background: var(--chip-accent);
	}

	.article-head h1 {
		max-width: 19ch;
		margin: 0.9rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(2.15rem, 5vw, 4.1rem);
		line-height: 1.06;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.article-head p {
		max-width: 48rem;
		margin: 0;
		color: var(--text-soft);
		font-size: 1.08rem;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.4rem;
		margin-top: 1.6rem;
		color: var(--text-soft);
	}

	.article-meta div {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}

	.article-meta strong {
		color: var(--text);
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1rem;
	}

	.article-tags .tag-chip {
		min-height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		text-decoration: underline;
		text-decoration-color: var(--line);
		text-underline-offset: 0.25rem;
	}

	.article-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.34fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}

	.article-body {
		grid-column: 1;
		max-width: 48rem;
		min-width: 0;
		padding: 0;
	}

	.article-aside {
		grid-column: 2;
		grid-row: 1;
		min-width: 0;
	}

	.related-posts {
		margin-top: clamp(3rem, 7vw, 5.5rem);
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.related-posts > h2 {
		margin: 0 0 0.8rem;
		font-family: var(--font-serif);
		font-size: clamp(1.65rem, 3vw, 2.35rem);
		letter-spacing: -0.025em;
	}

	.related-grid {
		display: grid;
		gap: 1rem;
		margin-top: 1rem;
	}

	@media (max-width: 1080px) {
		.article-layout {
			grid-template-columns: 1fr;
		}

		.article-aside,
		.article-body {
			grid-column: 1;
		}

		.article-aside { grid-row: 1; }
		.article-body { grid-row: 2; }
	}

	@media (max-width: 640px) {
		.article-shell { padding-top: 2.8rem; }
		.article-head h1 { font-size: clamp(2rem, 11vw, 3.1rem); }
		.article-meta { display: grid; gap: 0.55rem; }
	}
</style>
