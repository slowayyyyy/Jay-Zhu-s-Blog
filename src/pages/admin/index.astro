---
import { getCollection } from "astro:content";
import { join } from "node:path";
import mediaLibrary from "../../data/media-library.json";
import { buildAdminImageLibrary } from "../../lib/admin-image-library.mjs";

const initialPostStatuses = (await getCollection("posts")).map((post) => ({
	slug:
		post.filePath
			?.replaceAll("\\", "/")
			.split("/")
			.at(-1)
			?.replace(/\.(?:md|mdx)$/iu, "") ?? post.id,
	draft: post.data.draft,
	pinned: post.data.pinned,
	locked: Boolean(post.data.password?.trim()),
}));
const imageLibrary = await buildAdminImageLibrary(join(process.cwd(), "public"), mediaLibrary.assets);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="referrer" content="same-origin" />
		<link rel="icon" href="/favicon/azure-corridor.svg" type="image/svg+xml" />
		<title>苍蓝回廊 · 内容管理</title>
	</head>
	<body>
		<div class="cms-loading">正在打开博客内容管理后台...</div>
		<a class="typora-import-entry" href="/admin/typora/" aria-label="导入 Typora Markdown 文章">导入 Typora 文章</a>
		<script define:vars={{ initialPostStatuses, imageLibrary }} is:inline>
			window.__JAY_INITIAL_POST_STATUSES__ = initialPostStatuses;
			window.__JAY_IMAGE_LIBRARY__ = imageLibrary;
		</script>
		<script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
		<script>
			import { setupAdminCms } from '../../scripts/admin-cms.js';

			setupAdminCms();
		</script>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		min-height: 100%;
		background: #f4f7f8;
	}

	.cms-loading {
		position: fixed;
		inset: 0;
		z-index: 0;
		display: grid;
		place-items: center;
		color: #376d7b;
		font: 15px/1.6 sans-serif;
		pointer-events: none;
	}

	body:has(#nc-root > *) .cms-loading {
		display: none;
	}

	.typora-import-entry {
		position: fixed;
		z-index: 1000;
		right: max(1rem, env(safe-area-inset-right));
		bottom: max(1rem, env(safe-area-inset-bottom));
		padding: .68rem .85rem;
		border: 1px solid #b8d0d8;
		border-radius: 10px;
		background: #fff;
		box-shadow: 0 6px 18px rgb(15 44 55 / .12);
		color: #235e71;
		font: 650 14px/1.2 system-ui, "PingFang SC", sans-serif;
		text-decoration: none;
	}

	.typora-import-entry:hover { background: #f3fafb; }
	.typora-import-entry:focus-visible { outline: 3px solid #2e7f93; outline-offset: 3px; }
	.jay-image-library__open {
		min-height: 42px;
		padding: 9px 13px;
		border: 1px solid #2f7283;
		border-radius: 8px;
		background: #e8f4f6;
		color: #225969;
		font: 650 14px/1.3 system-ui, "PingFang SC", sans-serif;
		cursor: pointer;
	}
	.jay-image-library__open:hover,
	.jay-image-library__open[aria-expanded="true"] { background: #d8ebef; }
	.jay-image-library {
		margin: 0 0 14px;
		padding: 14px;
		border: 1px solid #c9d9df;
		border-radius: 12px;
		background: #fff;
		color: #253c44;
		font: 14px/1.45 system-ui, "PingFang SC", sans-serif;
	}
	.jay-image-library__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
	.jay-image-library__head strong { font-size: 16px; }
	.jay-image-library__close,
	.jay-image-library__more {
		padding: 7px 10px;
		border: 1px solid #b9cbd1;
		border-radius: 8px;
		background: #fff;
		color: #24596a;
		cursor: pointer;
	}
	.jay-image-library__note { margin: 7px 0 12px; color: #526b74; }
	.jay-image-library__search {
		width: 100%;
		min-height: 42px;
		padding: 9px 11px;
		border: 1px solid #aebdc3;
		border-radius: 8px;
		background: #fff;
		color: #1f2b30;
		font: 16px/1.3 system-ui, "PingFang SC", sans-serif;
	}
	.jay-image-library__scopes { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
	.jay-image-library__scope {
		padding: 7px 11px;
		border: 1px solid #bbccd2;
		border-radius: 8px;
		background: #fff;
		color: #31515b;
		font: 600 13px/1.3 system-ui, "PingFang SC", sans-serif;
		cursor: pointer;
	}
	.jay-image-library__scope[aria-pressed="true"] { border-color: #2f7283; background: #e8f4f6; color: #225969; }
	.jay-image-library__count { margin: 11px 0 8px; color: #526b74; font-size: 13px; }
	.jay-image-library__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
		gap: 10px;
		max-height: 470px;
		overflow-y: auto;
		padding: 2px;
	}
	.jay-image-library__item {
		min-width: 0;
		padding: 5px;
		border: 2px solid #d9e3e6;
		border-radius: 10px;
		background: #fff;
		color: #253c44;
		text-align: left;
		cursor: pointer;
	}
	.jay-image-library__item:hover { border-color: #7daebc; background: #f5fafb; }
	.jay-image-library__item[aria-pressed="true"] { border-color: #2f7283; background: #eaf5f7; }
	.jay-image-library__item img { display: block; width: 100%; aspect-ratio: 4 / 3; border-radius: 5px; background: #e4edf0; object-fit: cover; }
	.jay-image-library__name { display: block; margin-top: 6px; font-weight: 650; overflow-wrap: anywhere; }
	.jay-image-library__usage { display: block; margin-top: 2px; color: #59727a; line-height: 1.35; overflow-wrap: anywhere; }
	.jay-image-library__empty { margin: 12px 0; padding: 20px; border-radius: 8px; background: #f4f8f9; color: #526b74; }
	.jay-image-library__more { margin-top: 10px; }
	.jay-image-library button:focus-visible,
	.jay-image-library__open:focus-visible,
	.jay-image-library__search:focus-visible { outline: 3px solid #2e7f93; outline-offset: 2px; }

	.jay-markdown-toolbar {
		position: fixed;
		z-index: 999;
		left: 50%;
		bottom: max(1rem, env(safe-area-inset-bottom));
		transform: translateX(-50%);
		display: none;
		align-items: center;
		gap: .25rem;
		max-width: min(82vw, 740px);
		overflow-x: auto;
		padding: .4rem;
		border: 1px solid #c4d9df;
		border-radius: 12px;
		background: #fff;
		box-shadow: 0 8px 26px rgb(15 44 55 / .15);
	}
	.jay-markdown-toolbar.is-visible { display: flex; }
	.jay-markdown-toolbar.is-slate-editor button:not([data-command="sup"]):not([data-command="sub"]) { display: none; }
	.jay-markdown-toolbar button {
		flex: none;
		min-width: 36px;
		min-height: 36px;
		padding: .25rem .5rem;
		border: 0;
		border-radius: 7px;
		background: transparent;
		color: #254958;
		font: 650 13px/1.2 system-ui, "PingFang SC", sans-serif;
		cursor: pointer;
	}
	.jay-markdown-toolbar button:hover { background: #eaf4f6; }
	.jay-markdown-toolbar button:focus-visible { outline: 2px solid #2e7f93; }
	.jay-markdown-toolbar-status:empty { display: none; }
	.jay-markdown-toolbar-status { padding: 0 .4rem; color: #8b3737; font: 500 12px/1.3 system-ui, "PingFang SC", sans-serif; }
	@media (max-width: 700px) {
		.jay-markdown-toolbar { left: .5rem; right: .5rem; bottom: max(3.8rem, env(safe-area-inset-bottom)); transform: none; max-width: none; }
		.jay-image-library { padding: 10px; }
		.jay-image-library__grid { grid-template-columns: repeat(auto-fill, minmax(105px, 1fr)); }
	}
</style>
