---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteConfig } from '../data/site';
---

<SiteLayout pathname="/about/" title={`关于 | ${siteConfig.name}`} description="关于 Jay Zhu 的个人介绍、兴趣和联系方式。">
	<section class="container about-page">
		<div class="about-grid">
			<header class="profile-card">
				<img src={siteConfig.author.avatar} alt={`${siteConfig.author.displayName} 的头像`} />
				<div class="profile-copy">
					<h1>{siteConfig.author.displayName}</h1>
					<p class="muted" data-bilingual="text" data-zh={siteConfig.author.intro.zh} data-en={siteConfig.author.intro.en} />
				</div>
			</header>

			<div class="about-panels">
				<section class="about-card">
					<h2
						data-bilingual="text"
						data-zh={siteConfig.author.sectionTitles.research.zh}
						data-en={siteConfig.author.sectionTitles.research.en}
					>
						{siteConfig.author.sectionTitles.research.zh}
					</h2>
					<ul>
						{siteConfig.author.research.map((item) => (
							<li data-bilingual="text" data-zh={item.zh} data-en={item.en}>
								{item.zh}
							</li>
						))}
					</ul>
				</section>
				<section class="about-card">
					<h2
						data-bilingual="text"
						data-zh={siteConfig.author.sectionTitles.hobbies.zh}
						data-en={siteConfig.author.sectionTitles.hobbies.en}
					>
						{siteConfig.author.sectionTitles.hobbies.zh}
					</h2>
					<ul>
						{siteConfig.author.hobbies.map((item) => (
							<li data-bilingual="text" data-zh={item.zh} data-en={item.en}>
								{item.zh}
							</li>
						))}
					</ul>
				</section>
				<section class="about-card">
					<h2
						data-bilingual="text"
						data-zh={siteConfig.author.sectionTitles.current.zh}
						data-en={siteConfig.author.sectionTitles.current.en}
					>
						{siteConfig.author.sectionTitles.current.zh}
					</h2>
					<ul>
						{siteConfig.author.current.map((item) => (
							<li data-bilingual="text" data-zh={item.zh} data-en={item.en}>
								{item.zh}
							</li>
						))}
					</ul>
				</section>
				<section class="about-card">
					<h2
						data-bilingual="text"
						data-zh={siteConfig.author.sectionTitles.contact.zh}
						data-en={siteConfig.author.sectionTitles.contact.en}
					>
						{siteConfig.author.sectionTitles.contact.zh}
					</h2>
					<ul>
						{siteConfig.author.contact.map((item) => (
							<li>
								<strong>{item.label}</strong>
								<a href={item.value} target={item.value.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
									{item.display}
								</a>
							</li>
						))}
					</ul>
				</section>
			</div>
		</div>
	</section>
</SiteLayout>

<style>
	.about-page {
		padding: clamp(3.5rem, 7vw, 6rem) 0 4rem;
	}

	.about-grid {
		display: grid;
		gap: clamp(2.5rem, 7vw, 5rem);
	}

	.profile-card {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: end;
		gap: clamp(1.5rem, 4vw, 3rem);
		padding: 0 0 clamp(2rem, 5vw, 3.5rem);
		border-bottom: 1px solid var(--line);
	}

	.profile-card img {
		width: clamp(7rem, 14vw, 10rem);
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: var(--radius-md);
		filter: saturate(0.88);
	}

	.profile-copy h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2.8rem, 7vw, 5.4rem);
		line-height: 0.98;
		letter-spacing: -0.04em;
	}

	.profile-copy p { max-width: 44rem; margin: 1rem 0 0; font-size: 1.06rem; }

	.about-panels {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: 2.5rem clamp(2rem, 6vw, 5rem);
	}

	.about-card {
		padding-top: 1rem;
		border-top: 1px solid var(--line);
	}

	.about-card:nth-child(3),
	.about-card:nth-child(4) { grid-column: 1 / -1; }

	.about-card h2 {
		margin: 0 0 0.9rem;
		font-family: var(--font-serif);
		font-size: 1.25rem;
	}

	.about-card ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
		color: var(--text-soft);
	}

	.about-card li strong {
		display: block;
		color: var(--text);
		margin-bottom: 0.15rem;
	}

	.about-card a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		color: var(--accent);
	}

	.about-card li {
		padding: 0.75rem 0;
		border-bottom: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
	}

	.about-card:nth-child(3) ul {
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		column-gap: 2rem;
	}

	@media (max-width: 980px) {
		.about-panels {
			grid-template-columns: 1fr;
		}

		.about-card:nth-child(3),
		.about-card:nth-child(4) { grid-column: auto; }
	}

	@media (max-width: 640px) {
		.profile-card { grid-template-columns: 1fr; align-items: start; }
		.profile-card img { width: 6.5rem; }
	}
</style>
