---
import { Icon } from "astro-icon/components";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import azureContent from "@/data/azure-content.json";

const { musicPage, playlist } = azureContent;
---

<MainGridLayout title={musicPage.title} description={musicPage.intro}>
	<section class="music-shell card-base z-10 px-7 py-7 relative w-full onload-animation">
		<header class="music-hero">
			<div class="music-copy">
				<p>AZURE SOUNDTRACK / {playlist.length.toString().padStart(2, "0")}</p>
				<h1>{musicPage.title}</h1>
				<span>{musicPage.intro}</span>
			</div>
			<img src="/assets/images/roxy/roxy-motion.gif" alt="洛琪希与流动的水光" loading="eager" />
		</header>

		<article class="music-reference" aria-label="乐境参考内容">
			<span class="music-reference__icon"><Icon is:inline name="material-symbols:headphones-rounded" /></span>
			<div>
				<p>{musicPage.referenceMeta}</p>
				<h2>{musicPage.referenceTitle}</h2>
				<span>{musicPage.referenceText}</span>
			</div>
		</article>

		<div class="music-player-panel">
			<div class="music-player-heading"><Icon is:inline name="material-symbols:graphic-eq-rounded" /><span>正在播放</span></div>
			<MusicPlayer id="music-page-player" />
		</div>

		<div class="track-list">
			{playlist.map((track, index) => (
				<article class="track-card">
					<span class="track-index">{String(index + 1).padStart(2, "0")}</span>
					<div class="track-note"><Icon is:inline name="material-symbols:music-note-rounded" /></div>
					<div><h2>{track.name}</h2><p>{track.artist}</p></div>
					<Icon is:inline class="track-wave" name="material-symbols:equalizer-rounded" />
				</article>
			))}
		</div>
	</section>
</MainGridLayout>

<style>
	.music-shell{overflow:hidden}.music-hero{position:relative;display:grid;grid-template-columns:1fr minmax(10rem,16rem);min-height:14rem;overflow:hidden;border:1px solid color-mix(in srgb,var(--primary) 22%,var(--line-divider));border-radius:1.25rem;background:linear-gradient(125deg,color-mix(in srgb,#1d4ed8 15%,var(--card-bg)),color-mix(in srgb,#22d3ee 8%,var(--card-bg)))}.music-copy{position:relative;z-index:2;align-self:center;padding:1.7rem}.music-copy p{margin:0 0 .35rem;color:var(--primary);font-size:.65rem;font-weight:850;letter-spacing:.16em}.music-copy h1{margin:0;color:var(--content-regular);font-size:clamp(1.8rem,4vw,2.8rem)}.music-copy span{display:block;max-width:29rem;margin-top:.65rem;color:var(--content-meta);font-size:.86rem;line-height:1.75}.music-hero img{width:100%;height:100%;min-height:14rem;object-fit:cover;mask-image:linear-gradient(90deg,transparent,#000 35%)}
	.music-reference{display:grid;grid-template-columns:auto 1fr;gap:.85rem;align-items:start;margin-top:1rem;padding:1rem 1.1rem;border:1px solid color-mix(in srgb,var(--primary) 22%,var(--line-divider));border-radius:1.05rem;background:color-mix(in srgb,var(--card-bg) 94%,var(--primary) 6%)}.music-reference__icon{display:grid;width:2.5rem;height:2.5rem;place-items:center;border-radius:.8rem;color:white;background:linear-gradient(135deg,#2563eb,#22d3ee);box-shadow:0 .55rem 1.2rem rgb(37 99 235/.16)}.music-reference p{margin:0;color:var(--primary);font-size:.62rem;font-weight:850;letter-spacing:.08em}.music-reference h2{margin:.25rem 0 .2rem;color:var(--content-regular);font-size:1rem}.music-reference div>span{display:block;color:var(--content-meta);font-size:.8rem;line-height:1.7}
	.music-player-panel{margin-top:1rem;padding:1rem 1.1rem;border:1px solid var(--line-divider);border-radius:1.1rem;background:color-mix(in srgb,var(--card-bg) 96%,var(--primary) 4%)}.music-player-heading{display:flex;align-items:center;gap:.4rem;margin-bottom:.65rem;color:var(--primary);font-size:.72rem;font-weight:850;letter-spacing:.08em}
	.track-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin-top:1.1rem}.track-card{display:grid;grid-template-columns:auto auto 1fr auto;align-items:center;gap:.7rem;padding:.8rem .9rem;border:1px solid var(--line-divider);border-radius:.95rem;background:var(--card-bg);transition:transform .22s ease,border-color .22s ease}.track-card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--primary) 38%,var(--line-divider))}.track-index{color:var(--content-meta);font-size:.65rem;font-weight:800}.track-note{width:2.2rem;height:2.2rem;display:grid;place-items:center;border-radius:.7rem;color:var(--primary);background:color-mix(in srgb,var(--primary) 10%,transparent)}.track-card h2{margin:0;color:var(--content-regular);font-size:.82rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.track-card p{margin:.14rem 0 0;color:var(--content-meta);font-size:.67rem}.track-wave{color:var(--primary);opacity:.38}
	@media(max-width:640px){.music-shell{padding:1.15rem}.music-hero{grid-template-columns:1fr;min-height:15rem}.music-copy{padding:1.25rem}.music-hero img{position:absolute;inset:0;z-index:0;opacity:.25;mask-image:none}.track-list{grid-template-columns:1fr}}
</style>
