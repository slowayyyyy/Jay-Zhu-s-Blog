---
import { Icon } from "astro-icon/components";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import azureContent from "@/data/azure-content.json";
import room from "@/data/music-room.json";
import { musicLibrary, selectTracks } from "@/lib/music-library.mjs";
const library = musicLibrary(azureContent.playlist);
const featured = selectTracks(library, room.foyer.tracks);
const { musicPage } = azureContent;
---
<MainGridLayout title={musicPage.title} description={musicPage.intro}>
  <section class="music-foyer card-base" data-music-page="foyer" data-music-transition={JSON.stringify(room.transition)}>
    <header class="foyer-header">
      <div><h1>{musicPage.title}</h1><p>{musicPage.intro}</p></div>
      {musicPage.heroImage && <img src={musicPage.heroImage} alt={musicPage.heroImageAlt} />}
    </header>
    <MusicPlayer id="music-foyer-player" variant="foyer" />
    {room.enabled && <a href="/music/room/" class="room-entry" data-music-enter><span><strong>{room.entryLabel}</strong><small>{room.entryDescription}</small></span><Icon is:inline name="material-symbols:north-east-rounded" aria-hidden="true"/></a>}
    <div class="music-section-head"><div><h2>{room.foyer.title}</h2><p>{room.foyer.description}</p></div></div>
    <div class="foyer-tracks">
      {featured.map(track => <button class="song-row" data-song-index={track.index} aria-label={`播放 ${track.name}`}><img src={track.cover} alt="" loading="lazy"/><span><strong>{track.name}</strong><small>{track.artist}</small></span><span class="song-play" aria-hidden="true"><Icon is:inline name="material-symbols:play-arrow-rounded" class="song-play-icon"/><Icon is:inline name="material-symbols:pause-rounded" class="song-pause-icon"/></span></button>)}
    </div>
    {!featured.length && <p class="music-empty">{room.emptyMessage}</p>}
    {room.enabled && <a class="music-text-link" href="/music/room/#library" data-music-enter>查看全部 {library.length} 首歌曲 <Icon is:inline name="material-symbols:arrow-forward-rounded" aria-hidden="true"/></a>}
  </section>
</MainGridLayout>
