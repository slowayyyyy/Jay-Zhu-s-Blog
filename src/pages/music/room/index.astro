---
import { Icon } from "astro-icon/components";
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import azureContent from "@/data/azure-content.json";
import room from "@/data/music-room.json";
import { musicLibrary, selectTracks, cropStyle, coverFocusStyle, listeningNotes } from "@/lib/music-library.mjs";
import { roomPresentation } from "@/lib/music-room-settings.mjs";
const library = musicLibrary(azureContent.playlist);
const collections = room.collections || [];
const notes = listeningNotes(library);
const firstNote = notes.find(note=>note.index===0);
const appearance = roomPresentation(room);
const labels = appearance.labels;
const roomStyle = `--room-accent:${/^#[0-9a-f]{6}$/i.test(room.accent) ? room.accent : "#167eb3"};--room-record-size:${appearance.recordSize}px;--room-lyric-size:${appearance.lyricFontSize}px;--room-translation-size:${appearance.translationFontSize}px;--room-lyric-height:${appearance.lyricHeight}px;--room-scene-opacity:${appearance.backgroundOpacity / 100};--room-dark-scene-opacity:${appearance.darkBackgroundOpacity / 100}`;
---
<MainGridLayout title={room.title} description={room.intro}>
  <section class="listening-room windowlight-room" data-music-page="room" data-music-transition={JSON.stringify(room.transition)} data-room-panel="lyrics" data-room-options={JSON.stringify({miniMode:appearance.miniMode,focus:labels.focus,exitFocus:labels.exitFocus})} data-sleeve-library={appearance.sleeveLibrary} style={roomStyle}>
    {room.enabled ? <>
      {appearance.showBackground && appearance.backgroundImage.src && <div class:list={["room-scene", {"has-dark-scene":Boolean(appearance.darkBackgroundImage.src)}]} aria-hidden="true"><img class="room-scene-light room-scene-desktop" src={appearance.backgroundImage.src} alt="" style={cropStyle(appearance.backgroundImage)} fetchpriority="high" /><img class="room-scene-light room-scene-mobile" src={appearance.mobileBackgroundImage.src} alt="" style={cropStyle(appearance.mobileBackgroundImage)} />{appearance.darkBackgroundImage.src && <img class="room-scene-dark" src={appearance.darkBackgroundImage.src} alt="" style={cropStyle(appearance.darkBackgroundImage)} />}</div>}
      <header class="room-header">
        <div class="room-header-copy"><h1>{room.title}</h1><p>{room.intro}</p></div>
        <a href="/music/" data-music-return class="room-back"><Icon is:inline name="material-symbols:arrow-back-rounded" aria-hidden="true"/> {room.backLabel}</a>
      </header>
      <div class="room-turntable">
        <MusicPlayer id="music-room-player" variant="room">
        <div slot="room-tabs" class="room-tabs" role="tablist" aria-label="聆听内容">
          <button id="room-lyrics-tab" role="tab" aria-selected="true" aria-controls="music-room-player-lyrics" data-room-tab="lyrics">{labels.lyrics}</button>
          {room.showNotes && notes.length > 0 && <button id="room-note-tab" role="tab" aria-selected="false" aria-controls="room-note-panel" tabindex="-1" data-room-tab="note">{labels.notes}</button>}
        </div>
        <div slot="room-note" id="room-note-panel" class="room-note-panel" role="tabpanel" aria-labelledby="room-note-tab" tabindex="0" hidden>
        <section class="room-notes" data-current-note data-note-entries={JSON.stringify(notes)} aria-label={room.notesTitle} hidden={!firstNote}>
        <div class="music-section-head"><h2>{room.notesTitle}</h2></div>
        <article class="listening-note">
          <div><span class="note-song" data-note-song>{firstNote ? `${firstNote.name} · ${firstNote.artist}` : ""}</span><h3><span data-note-title>{firstNote?.title}</span><small class="note-reference" data-note-example hidden={!firstNote?.example}>参考手记</small></h3><div class="note-body" tabindex="0" role="region" aria-label="手记正文"><p data-note-text>{firstNote?.text}</p></div></div>
          <img class="note-cover" data-note-cover src={firstNote?.cover || undefined} alt={firstNote?.name || ""} hidden={!firstNote?.cover} loading="lazy"/>
        </article>
      </section>
      <p class="music-empty" data-note-missing hidden={Boolean(firstNote)}>{labels.emptyNote}</p>
      <details class="notes-archive" data-notes-archive>
        <summary>{room.allNotesLabel}<span class="notes-count">{notes.length}</span></summary>
        <label class="music-search notes-search"><span class="sr-only">{room.notesSearchPlaceholder}</span><input type="search" placeholder={room.notesSearchPlaceholder} data-note-search /></label>
        <div class="notes-archive-list">{notes.map(note=><details class="note-archive-item" data-note-search-text={`${note.name} ${note.artist} ${note.title} ${note.text}`.toLocaleLowerCase()}>
          <summary><strong>{note.name}</strong><span>{note.artist}</span></summary>
          <div class="note-archive-content"><h3>{note.title}{note.example && <small class="note-reference">参考手记</small>}</h3><p>{note.text}</p><button class="music-text-link" data-song-index={note.index}>听听《{note.name}》 <Icon is:inline name="material-symbols:arrow-forward-rounded" aria-hidden="true"/></button></div>
        </details>)}</div>
        <p class="music-empty" data-notes-empty hidden>{room.notesEmptyMessage}</p>
      </details>
      </div>
      </MusicPlayer>
      <button class="room-lyrics-reopen" data-room-reopen hidden>{labels.openLyrics}</button>
      {appearance.showFocus && <button class="room-focus" data-room-focus aria-pressed="false"><Icon is:inline name="material-symbols:filter-center-focus-outline-rounded" aria-hidden="true"/><span>{labels.focus}</span></button>}
      </div>
      <section id="library" class="room-library" data-library-view={room.defaultView} data-library-page-size={appearance.libraryPageSize}>
        <div class="music-section-head library-heading"><h2>{room.libraryTitle}<small>{library.length} 首</small></h2><label class="music-search"><Icon is:inline name="material-symbols:search-rounded" aria-hidden="true"/><span class="sr-only">{room.searchPlaceholder}</span><input type="search" placeholder={room.searchPlaceholder} data-song-search /></label><div class="library-view-switch" aria-label="歌曲展示方式"><button data-library-view-button="covers" aria-pressed={room.defaultView === "covers"}>{labels.covers}</button><button data-library-view-button="list" aria-pressed={room.defaultView === "list"}>{labels.list}</button></div></div>
        {room.showCollections && <nav class="room-collection-tabs" aria-label={room.collectionsTitle}>
          <button data-collection="all" data-members="null" aria-pressed="true"><strong>{labels.allTracks}</strong></button>
          {collections.map((collection,index) => <button data-collection={index} data-members={JSON.stringify(selectTracks(library,collection.tracks).map(track=>track.index))} aria-pressed="false" title={collection.description}><strong>{collection.name}</strong></button>)}
        </nav>}
        <div class="collection-filter" hidden><span data-filter-label></span><button data-clear-filter>显示全部 ×</button></div>
        <div class="library-songs" id="room-library-songs">{library.map((track,index)=><button class="song-row" data-song-index={track.index} data-song-search-text={`${track.name} ${track.artist}`.toLocaleLowerCase()} aria-label={`播放 ${track.name}`} title={`${track.name} · ${track.artist}`} hidden={index >= appearance.libraryPageSize}>
          <span class="song-number">{String(index+1).padStart(2,"0")}</span><span class="song-art"><img class="shelf-vinyl" src={room.player.recordImage?.src || "/assets/images/music-room/vinyl.webp"} alt="" loading="lazy"/><span class="shelf-cover-window">{track.cover ? <img class="shelf-cover" src={track.cover} style={coverFocusStyle(track.shelfCrop)} alt="" loading="lazy"/> : <Icon is:inline name="material-symbols:music-note-rounded" class="shelf-empty-icon" aria-hidden="true"/>}</span></span><span class="song-caption"><strong>{track.name}</strong><small>{track.artist}</small></span><span class="song-play" aria-hidden="true"><Icon is:inline name="material-symbols:play-arrow-rounded" class="song-play-icon"/><Icon is:inline name="material-symbols:pause-rounded" class="song-pause-icon"/></span>
        </button>)}</div><p class="music-empty" data-library-empty hidden>{room.emptyMessage}</p>
        <nav class="library-pagination" aria-label="唱片架分页" data-library-pagination hidden={library.length <= appearance.libraryPageSize}>
          <button data-library-previous aria-controls="room-library-songs" disabled><Icon is:inline name="material-symbols:chevron-left-rounded" aria-hidden="true"/>{labels.previousPage}</button>
          <span class="library-page-status" data-library-page-status role="status" aria-live="polite">1 / {Math.max(1,Math.ceil(library.length / appearance.libraryPageSize))} 页 · {library.length} 首</span>
          <select data-library-page-select aria-label="跳转到页" aria-controls="room-library-songs">{Array.from({length:Math.max(1,Math.ceil(library.length / appearance.libraryPageSize))},(_,index)=><option value={index}>第 {index + 1} 页</option>)}</select>
          <button data-library-next aria-controls="room-library-songs">{labels.nextPage}<Icon is:inline name="material-symbols:chevron-right-rounded" aria-hidden="true"/></button>
        </nav>
      </section>
      {room.player.showMini && <div class="room-mini" data-room-mini hidden={appearance.miniMode === 'auto'} inert={appearance.miniMode === 'auto'}><MusicPlayer id="music-room-mini" variant="mini"/></div>}
    </> : <div class="room-disabled"><h1>{room.title}</h1><p>聆听室暂未开放，仍可在乐境听歌。</p><a href="/music/">{room.backLabel} →</a></div>}
  </section>
</MainGridLayout>
