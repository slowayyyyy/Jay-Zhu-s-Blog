---
import PostCard from '../components/PostCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteConfig } from '../data/site';
import { getLifePosts, getPostSlug } from '../lib/content';

const posts = await getLifePosts();
const latest = posts[0];
const latestSlug = latest ? getPostSlug(latest) : null;
const remainingPosts = posts.slice(1);
---

<SiteLayout pathname="/life/" title={`生活手账 | ${siteConfig.name}`} description="记录阅读、锻炼与日常片段的生活栏目。">
	<section class="container life-page">
		<div class="life-head">
			<h1
				data-bilingual="text"
				data-zh={siteConfig.lifePage.title.zh}
				data-en={siteConfig.lifePage.title.en}
			>
				{siteConfig.lifePage.title.zh}
			</h1>
			<p
				class="muted"
				data-bilingual="text"
				data-zh={siteConfig.lifePage.intro.zh}
				data-en={siteConfig.lifePage.intro.en}
			>
				{siteConfig.lifePage.intro.zh}
			</p>
		</div>

		{
			latest && (
				<section class="life-highlight">
					<div class="highlight-copy">
						<h2>{latest.data.title}</h2>
						<p
							class="highlight-label"
							data-bilingual="text"
							data-zh={siteConfig.lifePage.highlightTitle.zh}
							data-en={siteConfig.lifePage.highlightTitle.en}
						>
							{siteConfig.lifePage.highlightTitle.zh}
						</p>
						<p>{latest.data.excerpt}</p>
						<a class="button-primary" href={`/posts/${latestSlug}/`} data-copy="common.readMore" />
					</div>
					<div class="highlight-side">
						<p
							data-bilingual="text"
							data-zh={siteConfig.lifePage.sidebar.zh}
							data-en={siteConfig.lifePage.sidebar.en}
						>
							{siteConfig.lifePage.sidebar.zh}
						</p>
					</div>
				</section>
			)
		}

		<div class="life-list">
			{remainingPosts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</SiteLayout>

<style>
	.life-page {
		padding: clamp(3.5rem, 7vw, 6rem) 0 4rem;
	}

	.life-head {
		max-width: 46rem;
	}

	.life-head h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2.8rem, 7vw, 5.2rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.life-head p {
		margin: 1rem 0 0;
		font-size: 1.05rem;
	}

	.life-highlight {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(15rem, 0.55fr);
		gap: clamp(2rem, 6vw, 5rem);
		margin-top: clamp(2rem, 5vw, 3.5rem);
		padding: clamp(1.5rem, 4vw, 3rem) 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.highlight-label {
		margin: 0 0 0.7rem;
		color: var(--accent-life);
		font-size: 0.85rem;
	}

	.highlight-copy h2 {
		margin: 0 0 0.35rem;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4vw, 3.2rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
	}

	.highlight-copy p,
	.highlight-side p {
		margin: 0;
		color: var(--text-soft);
	}

	.highlight-side {
		align-self: end;
		padding: 0.9rem 0 0 1.2rem;
		border-left: 1px solid var(--accent-life);
		font-family: var(--font-serif);
	}

	.life-list {
		display: grid;
		margin-top: 2.5rem;
	}

	@media (max-width: 900px) {
		.life-highlight {
			grid-template-columns: 1fr;
		}

		.highlight-side { border-top: 1px solid var(--line); border-left: 0; padding: 1rem 0 0; }
	}
</style>
