---
import OpeningOverlay from '../components/OpeningOverlay.astro';
import PostCard from '../components/PostCard.astro';
import TaxonomyPanel from '../components/TaxonomyPanel.astro';
import { siteConfig } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getAllPosts, getFeaturedPosts, getSectionSummary } from '../lib/content';

const posts = await getAllPosts();
const featuredPosts = await getFeaturedPosts();
const featuredIds = new Set(featuredPosts.map((post) => post.id));
const streamPosts = posts.filter((post) => !featuredIds.has(post.id));
const sectionSummary = getSectionSummary(posts);
---

<SiteLayout pathname="/" showOpening>
	<OpeningOverlay />

	<section class="home-hero container">
		<div class="hero-grid">
			<div class="hero-copy">
				<h1>{siteConfig.name}</h1>
				<p
					class="hero-text"
					data-bilingual="text"
					data-zh={siteConfig.homeIntro.zh}
					data-en={siteConfig.homeIntro.en}
				/>
				<div class="hero-actions">
					<a class="button-primary" href="/search/" data-copy="nav.search" />
					<a class="text-action" href="/about/" data-copy="nav.about" />
				</div>
				<blockquote
					data-bilingual="text"
					data-zh={`“${siteConfig.motto.zh}”`}
					data-en={`“${siteConfig.motto.en}”`}
				/>
			</div>

			<aside class="publication-index" aria-label="博客索引">
				<header>
					<h2>Index</h2>
					<span>2026</span>
				</header>
				<a class="index-row" href="/search/">
					<span data-copy="home.statsPosts">全部文章</span>
					<strong>{posts.length}</strong>
				</a>
				{
					sectionSummary.map((entry) => (
						<a class="index-row" href={`/search/?section=${entry.section}`}>
							<span data-copy={`section.${entry.section}`}>{entry.zh}</span>
							<strong>{entry.count}</strong>
						</a>
					))
				}
				<a class="index-checkins" href="/checkins/">
					<span data-copy="nav.checkins">每日打卡</span>
					<span data-copy="home.viewCheckins">查看记录</span>
				</a>
			</aside>
		</div>
	</section>

	{
		featuredPosts.length > 0 && (
			<section class="container featured-section" aria-labelledby="featured-title">
				<header class="section-head">
					<h2 id="featured-title" data-copy="home.featured" />
				</header>
				<div class="featured-list">
					{featuredPosts.map((post) => <PostCard post={post} headingLevel="h3" />)}
				</div>
			</section>
		)
	}

	<section class="container home-stream" aria-labelledby="latest-title">
		<header class="section-head stream-head">
			<div>
				<h2 id="latest-title" data-copy="home.latestTitle" />
				<p data-copy="home.latestIntro" />
			</div>
			<span class="stream-count">{streamPosts.length} entries</span>
		</header>

		<div class="stream-layout">
			<div class="post-stream">
				{streamPosts.map((post) => <PostCard post={post} headingLevel="h3" />)}
			</div>
			<aside class="stream-sidebar">
				<div class="margin-note">
					<h2 data-copy="home.sidebarTitle" />
					<p data-copy="home.sidebarBody" />
				</div>
				<TaxonomyPanel posts={posts} />
			</aside>
		</div>
	</section>
</SiteLayout>

<style>
	.home-hero {
		padding: clamp(3.5rem, 8vw, 7rem) 0 2rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.65fr);
		gap: clamp(2rem, 6vw, 5.5rem);
		padding: clamp(2rem, 5vw, 4.5rem) 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.hero-copy h1 {
		max-width: 14ch;
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(3rem, 7vw, 5.8rem);
		line-height: 0.98;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.hero-text {
		max-width: 43rem;
		margin: 1.4rem 0 0;
		color: var(--text-soft);
		font-size: clamp(1rem, 1.4vw, 1.12rem);
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		margin-top: 1.8rem;
	}

	.text-action {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		color: var(--text-soft);
		text-decoration: underline;
		text-decoration-color: var(--line);
		text-underline-offset: 0.35rem;
	}

	.text-action:hover {
		color: var(--accent);
		text-decoration-color: currentColor;
	}

	.hero-copy blockquote {
		position: relative;
		max-width: 37rem;
		margin: 2rem 0 0;
		padding: 1rem 0 0 1.25rem;
		border-top: 1px solid var(--line);
		color: var(--text-soft);
		font-family: var(--font-serif);
		font-size: 1rem;
	}

	.hero-copy blockquote::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		width: 4.5rem;
		height: 1px;
		background: var(--focus-ring);
	}

	.publication-index {
		align-self: center;
		padding-left: clamp(1.4rem, 3vw, 2.5rem);
		border-left: 1px solid var(--line);
	}

	.publication-index header,
	.index-row,
	.index-checkins {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.publication-index header {
		padding-bottom: 0.75rem;
		color: var(--text-soft);
	}

	.publication-index h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 600;
	}

	.publication-index header span {
		font-size: 0.76rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.08em;
	}

	.index-row {
		min-height: 3.25rem;
		border-top: 1px solid var(--line);
		color: var(--text-soft);
	}

	.index-row strong {
		color: var(--text);
		font-variant-numeric: tabular-nums;
	}

	.index-row:hover { color: var(--accent); }

	.index-checkins {
		min-height: 3.5rem;
		margin-top: 0.6rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--line);
		color: var(--accent);
	}

	.index-checkins span:last-child {
		color: var(--text-soft);
		font-size: 0.78rem;
	}

	.featured-section,
	.home-stream {
		padding: 2.5rem 0;
	}

	.section-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 0.8rem;
	}

	.section-head h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.8rem, 3vw, 2.6rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.section-head p {
		max-width: 42rem;
		margin: 0.55rem 0 0;
		color: var(--text-soft);
	}

	.stream-count {
		padding-bottom: 0.2rem;
		color: var(--text-soft);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.08em;
	}

	.stream-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(17rem, 0.65fr);
		gap: clamp(2rem, 5vw, 4rem);
	}

	.stream-sidebar {
		display: grid;
		gap: 2.4rem;
		align-content: start;
		padding-top: 1.6rem;
	}

	.margin-note {
		padding-top: 1rem;
		border-top: 1px solid var(--line);
	}

	.margin-note h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.15rem;
	}

	.margin-note p {
		margin: 0.65rem 0 0;
		color: var(--text-soft);
		font-size: 0.9rem;
	}

	html[data-intro-load='seen'] .home-hero {
		animation: home-reveal 760ms 120ms both;
	}

	@keyframes home-reveal {
		from { opacity: 0; clip-path: inset(0 0 12% 0); transform: translateY(16px); }
		to { opacity: 1; clip-path: inset(0); transform: translateY(0); }
	}

	@media (max-width: 940px) {
		.hero-grid,
		.stream-layout {
			grid-template-columns: 1fr;
		}

		.publication-index {
			padding: 1.5rem 0 0;
			border-top: 1px solid var(--line);
			border-left: 0;
		}

		.stream-sidebar { padding-top: 0; }
	}

	@media (max-width: 640px) {
		.home-hero { padding-top: 2.5rem; }
		.hero-grid { padding-block: 2rem; }
		.hero-copy h1 { font-size: clamp(2.65rem, 13vw, 4.25rem); }
		.hero-actions { flex-wrap: wrap; }
		.section-head { align-items: start; }
		.stream-count { display: none; }
	}
</style>
