---
import OpeningOverlay from '../components/OpeningOverlay.astro';
import PostCard from '../components/PostCard.astro';
import TaxonomyPanel from '../components/TaxonomyPanel.astro';
import { siteConfig } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatDate, getAllPosts, getFeaturedPosts, getPostSlug, getSectionSummary } from '../lib/content';

const posts = await getAllPosts();
const featuredPosts = await getFeaturedPosts();
const featuredIds = new Set(featuredPosts.map((post) => post.id));
const streamPosts = posts.filter((post) => !featuredIds.has(post.id));
const sectionSummary = getSectionSummary(posts);
const latestPost = posts[0];
const latestPostSlug = latestPost ? getPostSlug(latestPost) : '';
const publicationYears = [...new Set(posts.map((post) => post.data.publishDate.getFullYear()))];
const publicationYearLabel = publicationYears.length > 1
	? `${Math.min(...publicationYears)}—${Math.max(...publicationYears)}`
	: String(publicationYears[0] ?? new Date().getFullYear());
---

<SiteLayout pathname="/" showOpening>
	<OpeningOverlay />

	<section class="home-hero container">
		<div class="hero-grid">
			<div class="hero-copy">
				<h1>{siteConfig.name}</h1>
				<p
					class="hero-text"
					data-bilingual="text"
					data-zh={siteConfig.homeIntro.zh}
					data-en={siteConfig.homeIntro.en}
				/>
				<div class="hero-actions">
					{
						latestPost && (
							<a
								class="button-primary"
								href={`/posts/${latestPostSlug}/`}
								data-bilingual="text"
								data-zh={siteConfig.homePage.startReading.zh}
								data-en={siteConfig.homePage.startReading.en}
							/>
						)
					}
					<a class="text-action" href="/search/" data-copy="nav.search" />
				</div>
				<blockquote
					data-bilingual="text"
					data-zh={`“${siteConfig.motto.zh}”`}
					data-en={`“${siteConfig.motto.en}”`}
				/>
			</div>

			<aside class="publication-index" aria-label="博客索引">
				<header>
					<h2
						data-bilingual="text"
						data-zh={siteConfig.homePage.contentIndexTitle.zh}
						data-en={siteConfig.homePage.contentIndexTitle.en}
					/>
					<span>{publicationYearLabel}</span>
				</header>
				<a class="index-row" href="/search/">
					<span
						data-bilingual="text"
						data-zh={siteConfig.homePage.allPostsLabel.zh}
						data-en={siteConfig.homePage.allPostsLabel.en}
					/>
					<strong>{posts.length}</strong>
				</a>
				{
					sectionSummary.map((entry) => (
						<a class="index-row" href={`/search/?section=${entry.section}`}>
							<span data-copy={`section.${entry.section}`}>{entry.zh}</span>
							<strong>{entry.count}</strong>
						</a>
					))
				}
				<a class="index-checkins" href="/checkins/">
					<span
						data-bilingual="text"
						data-zh={siteConfig.homePage.checkinsLabel.zh}
						data-en={siteConfig.homePage.checkinsLabel.en}
					/>
					<span
						data-bilingual="text"
						data-zh={siteConfig.homePage.viewCheckinsLabel.zh}
						data-en={siteConfig.homePage.viewCheckinsLabel.en}
					/>
				</a>
				{
					latestPost && (
						<a class="latest-update" href={`/posts/${latestPostSlug}/`}>
							<span
								data-bilingual="text"
								data-zh={siteConfig.homePage.latestUpdated.zh}
								data-en={siteConfig.homePage.latestUpdated.en}
							/>
							<strong>{latestPost.data.title}</strong>
							<time datetime={latestPost.data.publishDate.toISOString()}>
								{formatDate(latestPost.data.publishDate)}
							</time>
						</a>
					)
				}
			</aside>
		</div>
	</section>

	{
		featuredPosts.length > 0 && (
			<section class="container featured-section" aria-labelledby="featured-title">
				<header class="section-head">
					<h2
						id="featured-title"
						data-bilingual="text"
						data-zh={siteConfig.homePage.featuredTitle.zh}
						data-en={siteConfig.homePage.featuredTitle.en}
					/>
				</header>
				<div class:list={['featured-list', `featured-list--${featuredPosts.length}`]}>
					{featuredPosts.map((post) => <PostCard post={post} headingLevel="h3" />)}
				</div>
			</section>
		)
	}

	<section class="container home-stream" id="latest" aria-labelledby="latest-title">
		<header class="section-head stream-head">
			<div>
				<h2
					id="latest-title"
					data-bilingual="text"
					data-zh={siteConfig.homePage.latestTitle.zh}
					data-en={siteConfig.homePage.latestTitle.en}
				/>
				<p
					data-bilingual="text"
					data-zh={siteConfig.homePage.latestIntro.zh}
					data-en={siteConfig.homePage.latestIntro.en}
				/>
			</div>
			<span
				class="stream-count"
				data-bilingual="text"
				data-zh={`${streamPosts.length} 篇`}
				data-en={`${streamPosts.length} entries`}
			/>
		</header>

		<div class="stream-layout">
			<div class="post-stream">
				{streamPosts.map((post) => <PostCard post={post} headingLevel="h3" />)}
			</div>
			<aside class="stream-sidebar">
				<div class="margin-note">
					<h2
						data-bilingual="text"
						data-zh={siteConfig.homePage.sidebarTitle.zh}
						data-en={siteConfig.homePage.sidebarTitle.en}
					/>
					<p
						data-bilingual="text"
						data-zh={siteConfig.homePage.sidebarBody.zh}
						data-en={siteConfig.homePage.sidebarBody.en}
					/>
				</div>
				<TaxonomyPanel posts={posts} />
			</aside>
		</div>
	</section>
</SiteLayout>

<style>
	.home-hero {
		padding: clamp(2.5rem, 5vw, 4.75rem) 0 2rem;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.65fr);
		gap: clamp(2.5rem, 6vw, 5.5rem);
		padding: clamp(2.5rem, 5vw, 4.25rem) 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.hero-copy h1 {
		max-width: 14ch;
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(3rem, 7vw, 5.8rem);
		line-height: 0.98;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.hero-text {
		max-width: 40rem;
		margin: 1.4rem 0 0;
		color: var(--text-soft);
		font-size: clamp(1rem, 1.4vw, 1.12rem);
		line-height: 1.9;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		margin-top: 1.8rem;
	}

	.hero-actions .button-primary {
		position: relative;
		padding-right: 3rem;
		background: var(--accent);
		box-shadow: 0 14px 30px color-mix(in srgb, var(--accent) 22%, transparent);
	}

	.hero-actions .button-primary::after {
		content: '';
		position: absolute;
		right: 1.25rem;
		width: 0.5rem;
		height: 0.5rem;
		border-top: 1px solid currentColor;
		border-right: 1px solid currentColor;
		transform: rotate(45deg);
		transition: transform var(--transition);
	}

	.hero-actions .button-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 18px 36px color-mix(in srgb, var(--accent) 28%, transparent);
	}

	.hero-actions .button-primary:hover::after {
		transform: translateX(0.2rem) rotate(45deg);
	}

	.hero-actions .button-primary:active {
		transform: translateY(0) scale(0.98);
	}

	.text-action {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		color: var(--text-soft);
		text-decoration: underline;
		text-decoration-color: var(--line);
		text-underline-offset: 0.35rem;
	}

	.text-action:hover {
		color: var(--accent);
		text-decoration-color: currentColor;
	}

	.hero-copy blockquote {
		position: relative;
		max-width: 37rem;
		margin: 2rem 0 0;
		padding: 1rem 0 0 1.25rem;
		border-top: 1px solid var(--line);
		color: var(--text-soft);
		font-family: var(--font-serif);
		font-size: 1.03rem;
		font-style: italic;
	}

	.hero-copy blockquote::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		width: 4.5rem;
		height: 1px;
		background: var(--focus-ring);
	}

	.publication-index {
		align-self: center;
		padding-left: clamp(1.4rem, 3vw, 2.5rem);
		border-left: 1px solid var(--line);
	}

	.publication-index header,
	.index-row,
	.index-checkins {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.publication-index header {
		padding-bottom: 0.75rem;
		color: var(--text-soft);
	}

	.publication-index h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 600;
	}

	.publication-index header span {
		font-size: 0.76rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.08em;
	}

	.index-row {
		min-height: 3.25rem;
		border-top: 1px solid var(--line);
		color: var(--text-soft);
	}

	.index-row strong {
		color: var(--text);
		font-variant-numeric: tabular-nums;
	}

	.index-row:hover { color: var(--accent); }

	.index-checkins {
		min-height: 3.5rem;
		margin-top: 0.6rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--line);
		color: var(--accent);
	}

	.index-checkins span:last-child {
		color: var(--text-soft);
		font-size: 0.78rem;
	}

	.latest-update {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.3rem 1rem;
		margin-top: 0.75rem;
		padding: 1rem 0 0 1rem;
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--accent);
		color: var(--text-soft);
	}

	.latest-update > span {
		font-size: 0.78rem;
		letter-spacing: 0.06em;
	}

	.latest-update strong {
		grid-column: 1 / -1;
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.35;
	}

	.latest-update time {
		grid-column: 2;
		grid-row: 1;
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
	}

	.latest-update:hover strong {
		color: var(--accent);
	}

	.featured-section,
	.home-stream {
		padding: clamp(2.75rem, 5vw, 4.5rem) 0;
	}

	.featured-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: clamp(2rem, 5vw, 4rem);
	}

	.featured-list--1 {
		grid-template-columns: minmax(0, 1fr);
	}

	.featured-list--3 :global(.post-card:first-child) {
		grid-column: 1 / -1;
		padding-block: 2rem;
	}

	.featured-list--2 :global(.post-card),
	.featured-list--3 :global(.post-card:not(:first-child)) {
		grid-template-columns: 1fr auto;
		gap: 0.75rem 1rem;
		align-content: start;
		padding-block: 1.6rem;
	}

	.featured-list--2 :global(.post-card .post-rail),
	.featured-list--2 :global(.post-card .post-content),
	.featured-list--3 :global(.post-card:not(:first-child) .post-rail),
	.featured-list--3 :global(.post-card:not(:first-child) .post-content) {
		grid-column: 1 / -1;
	}

	.featured-list--2 :global(.post-card .post-rail),
	.featured-list--3 :global(.post-card:not(:first-child) .post-rail) {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.featured-list--2 :global(.post-card .read-link),
	.featured-list--3 :global(.post-card:not(:first-child) .read-link) {
		grid-column: 1;
		justify-self: start;
	}

	.section-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 0.8rem;
	}

	.section-head h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.8rem, 3vw, 2.6rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.section-head p {
		max-width: 42rem;
		margin: 0.55rem 0 0;
		color: var(--text-soft);
	}

	.stream-count {
		padding-bottom: 0.2rem;
		color: var(--text-soft);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.08em;
	}

	.stream-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(17rem, 0.65fr);
		gap: clamp(2rem, 5vw, 4rem);
	}

	.stream-sidebar {
		display: grid;
		gap: 2.4rem;
		align-content: start;
		padding-top: 1.6rem;
	}

	.margin-note {
		position: relative;
		padding: 1.2rem 0 0 1rem;
		border-top: 1px solid var(--line);
	}

	.margin-note::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		width: 3rem;
		height: 1px;
		background: var(--accent);
	}

	.margin-note h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.15rem;
	}

	.margin-note p {
		margin: 0.65rem 0 0;
		color: var(--text-soft);
		font-size: 0.9rem;
	}

	html[data-intro-load='seen'] .home-hero {
		animation: home-reveal 760ms 120ms both;
	}

	@keyframes home-reveal {
		from { opacity: 0; clip-path: inset(0 0 12% 0); transform: translateY(16px); }
		to { opacity: 1; clip-path: inset(0); transform: translateY(0); }
	}

	@media (max-width: 940px) {
		.hero-grid,
		.stream-layout {
			grid-template-columns: 1fr;
		}

		.publication-index {
			padding: 1.5rem 0 0;
			border-top: 1px solid var(--line);
			border-left: 0;
		}

		.stream-sidebar { padding-top: 0; }
	}

	@media (max-width: 760px) {
		.featured-list {
			grid-template-columns: 1fr;
		}

		.featured-list--3 :global(.post-card:first-child) {
			grid-column: auto;
		}
	}

	@media (max-width: 640px) {
		.home-hero { padding-top: 1.6rem; }
		.hero-grid {
			gap: 1.4rem;
			padding-block: 2rem 1.5rem;
		}
		.hero-copy h1 { font-size: clamp(2.65rem, 13vw, 4.25rem); }
		.hero-actions { flex-wrap: wrap; }
		.hero-copy blockquote { margin-top: 1.5rem; }

		.publication-index {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			padding-top: 1rem;
		}

		.publication-index header,
		.index-checkins {
			grid-column: 1 / -1;
		}

		.publication-index header {
			padding-bottom: 0.45rem;
		}

		.index-row {
			min-height: 2.75rem;
			padding-right: 0.65rem;
		}

		.index-row:nth-of-type(even) {
			padding-left: 0.65rem;
			padding-right: 0;
			border-left: 1px solid var(--line);
		}

		.index-checkins {
			min-height: 3rem;
			margin-top: 0.25rem;
			padding-top: 0.25rem;
		}

		.latest-update { display: none; }
		.section-head { align-items: start; }
		.stream-count { display: none; }
	}
</style>
