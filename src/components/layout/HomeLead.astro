---
import { Icon } from "astro-icon/components";
import azureContent from "@/data/azure-content.json";

interface Props {
	postCount: number;
}

const { postCount } = Astro.props;
---

<section class="azure-home-lead" id="recent-notes" aria-labelledby="recent-notes-title">
  <div class="azure-home-lead-copy">
    <h2 id="recent-notes-title">{azureContent.home.recentTitle}</h2>
    <p>{azureContent.home.recentIntro}</p>
  </div>
  <div class="azure-home-lead-meta">
    <span><strong>{postCount}</strong> 篇记录</span>
    <a href="/archive/">
      查看全部归档
      <Icon name="material-symbols:arrow-forward-rounded" />
    </a>
  </div>
  <corridor-moment
    class="azure-corridor-moment"
    data-quotes={JSON.stringify(azureContent.home.momentQuotes)}
  >
    <div class="azure-moment-time" aria-label="访客本地时间">
      <span data-greeting>此刻</span>
      <strong data-time>--:--</strong>
      <small data-date>正在读取本地时间</small>
    </div>
    <p data-quote>{azureContent.home.momentQuotes[0]}</p>
    <button type="button" data-weather title="点击后临时读取浏览器位置以查询天气，不会保存位置">
      <Icon name="material-symbols:partly-cloudy-day-outline-rounded" />
      <span>查看此刻天气</span>
    </button>
  </corridor-moment>
</section>

<script is:inline>
  if (!customElements.get('corridor-moment')) {
    class CorridorMoment extends HTMLElement {
      timer;

      connectedCallback() {
        if (this.dataset.ready === 'true') return;
        this.dataset.ready = 'true';
        this.updateTime();
        this.timer = window.setInterval(() => this.updateTime(), 30_000);

        const quotes = JSON.parse(this.dataset.quotes || '[]');
        const quote = this.querySelector('[data-quote]');
        if (quote && quotes.length > 0) {
          const now = new Date();
          const start = new Date(now.getFullYear(), 0, 0);
          const day = Math.floor((now.getTime() - start.getTime()) / 86_400_000);
          quote.textContent = quotes[day % quotes.length];
        }

        this.querySelector('[data-weather]')?.addEventListener('click', this.loadWeather);
      }

      disconnectedCallback() {
        window.clearInterval(this.timer);
        this.querySelector('[data-weather]')?.removeEventListener('click', this.loadWeather);
        delete this.dataset.ready;
      }

      updateTime = () => {
        const now = new Date();
        const hour = now.getHours();
        const greeting = hour < 6 ? '夜深了' : hour < 11 ? '早上好' : hour < 14 ? '中午好' : hour < 18 ? '下午好' : '晚上好';
        const greetingNode = this.querySelector('[data-greeting]');
        const timeNode = this.querySelector('[data-time]');
        const dateNode = this.querySelector('[data-date]');
        if (greetingNode) greetingNode.textContent = greeting;
        if (timeNode) timeNode.textContent = new Intl.DateTimeFormat('zh-CN', { hour: '2-digit', minute: '2-digit', hour12: false }).format(now);
        if (dateNode) dateNode.textContent = new Intl.DateTimeFormat('zh-CN', { month: 'long', day: 'numeric', weekday: 'long' }).format(now);
      };

      loadWeather = () => {
        const button = this.querySelector('[data-weather]');
        const label = button?.querySelector('span');
        if (!button || !label || !navigator.geolocation) {
          if (label) label.textContent = '浏览器不支持定位';
          return;
        }

        button.disabled = true;
        label.textContent = '正在读取天气';
        navigator.geolocation.getCurrentPosition(async ({ coords }) => {
          try {
            const endpoint = new URL('https://api.open-meteo.com/v1/forecast');
            endpoint.searchParams.set('latitude', String(coords.latitude));
            endpoint.searchParams.set('longitude', String(coords.longitude));
            endpoint.searchParams.set('current', 'temperature_2m,weather_code');
            endpoint.searchParams.set('timezone', 'auto');
            const response = await fetch(endpoint);
            if (!response.ok) throw new Error('weather request failed');
            const data = await response.json();
            const code = Number(data.current?.weather_code);
            const condition = code === 0 ? '晴' : code <= 3 ? '多云' : code <= 48 ? '有雾' : code <= 67 ? '有雨' : code <= 77 ? '有雪' : code <= 82 ? '阵雨' : '雷雨';
            label.textContent = `${condition} · ${Math.round(data.current?.temperature_2m)}°C`;
          } catch {
            label.textContent = '天气暂时不可用';
            button.disabled = false;
          }
        }, () => {
          label.textContent = '未读取位置';
          button.disabled = false;
        }, { enableHighAccuracy: false, timeout: 8_000, maximumAge: 900_000 });
      };
    }
    customElements.define('corridor-moment', CorridorMoment);
  }
</script>
