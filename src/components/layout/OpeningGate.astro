---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import openingPoster from "@/assets/images/azure/roxy-water-magic.jpg";
import azureContent from "@/data/azure-content.json";

const config = azureContent.opening;
---

<script is:inline>
  try {
    if (sessionStorage.getItem('azure-opening-seen') === '1') {
      document.documentElement.dataset.azureOpeningSeen = 'true';
    }
  } catch {}
</script>

{config.enabled && (
  <azure-opening class="azure-opening" role="dialog" aria-modal="true" aria-labelledby="azure-opening-title">
    <div class="azure-opening-media" aria-hidden="true">
      <Image
        src={openingPoster}
        alt=""
        widths={[960, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      {config.videoUrl && (
        <video
          poster={openingPoster.src}
          muted
          autoplay
          loop
          playsinline
          preload="metadata"
          data-opening-video
        >
          <source src={config.videoUrl} type="video/mp4" />
          <source src="/media/opening-roxy-720p.mp4" type="video/mp4" />
        </video>
      )}
    </div>

    <div class="azure-opening-veil" aria-hidden="true"></div>
    <div class="azure-opening-runes" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <div class="azure-opening-copy">
      <div class="azure-opening-mark" aria-hidden="true">
        <Icon name="material-symbols:water-drop-outline-rounded" />
      </div>
      <p class="azure-opening-kicker">{config.kicker}</p>
      <h1 id="azure-opening-title">{config.title}</h1>
      <p class="azure-opening-subtitle">{config.subtitle}</p>
      <button type="button" data-enter>
        <span>{config.enterLabel}</span>
        <Icon name="material-symbols:arrow-forward-rounded" />
      </button>
      <small>{config.hint}</small>
    </div>
    <span class="azure-opening-ripple" aria-hidden="true"></span>
  </azure-opening>
)}

<script is:inline>
  if (!customElements.get('azure-opening')) {
    class AzureOpening extends HTMLElement {
      connectedCallback() {
        if (document.documentElement.dataset.azureOpeningSeen === 'true') {
          this.hidden = true;
          return;
        }

        document.documentElement.classList.add('azure-opening-active');
        const video = this.querySelector('[data-opening-video]');
        video?.addEventListener('error', () => this.classList.add('is-poster'), { once: true });
        video?.play?.().catch(() => this.classList.add('is-poster'));
        this.querySelector('[data-enter]')?.addEventListener('click', () => this.enter(), { once: true });
      }

      enter() {
        try { sessionStorage.setItem('azure-opening-seen', '1'); } catch {}
        document.documentElement.dataset.azureOpeningSeen = 'true';
        document.documentElement.classList.remove('azure-opening-active');
        this.classList.add('is-leaving');

        const manager = window.__fireflyMusic;
        if (manager) {
          void manager.init();
          if (!manager.getState().isPlaying) manager.togglePlay();
        }

        window.setTimeout(() => {
          this.querySelector('[data-opening-video]')?.pause?.();
          this.hidden = true;
          this.dispatchEvent(new CustomEvent('azure:entered', { bubbles: true }));
        }, window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 80 : 1100);
      }
    }
    customElements.define('azure-opening', AzureOpening);
  }
</script>
