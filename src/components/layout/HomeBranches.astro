---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import roxyField from "@/assets/images/azure/roxy-field.jpg";
import roxyStudy from "@/assets/images/azure/roxy-study.jpg";
import { musicPlayerConfig } from "@/config/musicConfig";
import azureContent from "@/data/azure-content.json";

const songCount = musicPlayerConfig.local?.playlist?.length ?? 0;
---

<section class="azure-home-branches" aria-labelledby="azure-branches-title">
  <header class="azure-branches-heading">
    <div>
      <span>{azureContent.home.branchesKicker}</span>
      <h2 id="azure-branches-title">{azureContent.home.branchesTitle}</h2>
    </div>
    <p>{azureContent.home.branchesIntro}</p>
  </header>

  <div class="azure-branches-ribbon" aria-hidden="true"><span></span></div>

  <div class="azure-branches-mosaic">
    <a class="azure-branch azure-branch-music" href="/music/">
      <Image src={roxyStudy} alt="洛琪希在书房中阅读" widths={[520, 760, 980]} sizes="(max-width: 767px) 100vw, 48vw" loading="lazy" />
      <div>
        <span>乐境 · {songCount} 首收藏</span>
        <h3>{azureContent.home.musicTitle}</h3>
        <p>{azureContent.home.musicDescription}</p>
        <Icon name="material-symbols:arrow-outward-rounded" />
      </div>
    </a>

    <a class="azure-branch azure-branch-gallery" href="/gallery/">
      <Image src={roxyField} alt="洛琪希走在原野间" widths={[420, 620, 820]} sizes="(max-width: 767px) 100vw, 33vw" loading="lazy" />
      <div>
        <span>画廊</span>
        <h3>{azureContent.home.galleryTitle}</h3>
        <Icon name="material-symbols:arrow-forward-rounded" />
      </div>
    </a>

    <a class="azure-branch azure-branch-dynamic" href="/dynamic/">
      <span>说说 / MOMENTS</span>
      <blockquote>{azureContent.home.dynamicQuote}</blockquote>
      <div>去看日常 <Icon name="material-symbols:arrow-forward-rounded" /></div>
    </a>

    <a class="azure-branch azure-branch-anime" href="/bilibili/">
      <span>追番</span>
      <strong>{azureContent.home.animeTitle}</strong>
      <small>{azureContent.home.animeStatus}</small>
    </a>

    <a class="azure-branch azure-branch-about" href="/about/">
      <span>关于我</span>
      <strong>{azureContent.home.aboutTitle}</strong>
      <Icon name="material-symbols:arrow-outward-rounded" />
    </a>
  </div>
</section>
