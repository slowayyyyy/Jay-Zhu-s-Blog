---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import defaultCover from "@/assets/images/azure/roxy-study.jpg";
import { musicPlayerConfig } from "@/config/musicConfig";
import azureContent from "@/data/azure-content.json";

const songCount = musicPlayerConfig.local?.playlist?.length ?? 0;
---

<section class="azure-music-stage" data-azure-music-page>
  <div class="azure-music-heading">
    <h1>{azureContent.musicPage.title}</h1>
    <p>{azureContent.musicPage.intro}</p>
    <span>{songCount} 首收藏</span>
  </div>

  <div class="azure-music-workspace">
    <div class="azure-music-now">
      <div class="azure-music-disc" data-music-disc>
        <div class="azure-music-disc-ring"></div>
        <Image
          src={defaultCover}
          alt="默认唱片封面"
          widths={[360, 560, 760]}
          sizes="(max-width: 767px) 72vw, 27vw"
          class="azure-music-cover"
          data-music-cover
          loading="eager"
        />
        <span class="azure-music-disc-core"></span>
      </div>

      <div class="azure-music-track-copy">
        <h2 data-music-title>等待播放</h2>
        <p data-music-artist>从歌单里选择一首歌</p>
      </div>

      <div class="azure-music-timeline">
        <input data-music-progress type="range" min="0" max="100" step="0.1" value="0" aria-label="播放进度" />
        <div>
          <span data-music-current>0:00</span>
          <span data-music-duration>0:00</span>
        </div>
      </div>

      <div class="azure-music-controls">
        <button type="button" data-music-mode aria-label="切换播放模式" title="列表循环">
          <Icon name="material-symbols:repeat-rounded" />
        </button>
        <button type="button" data-music-prev aria-label="上一首">
          <Icon name="material-symbols:skip-previous-rounded" />
        </button>
        <button type="button" class="azure-music-play" data-music-play aria-label="播放">
          <Icon name="material-symbols:play-arrow-rounded" class="azure-icon-play" />
          <Icon name="material-symbols:pause-rounded" class="azure-icon-pause" />
        </button>
        <button type="button" data-music-next aria-label="下一首">
          <Icon name="material-symbols:skip-next-rounded" />
        </button>
        <label class="azure-music-volume">
          <Icon name="material-symbols:volume-up-rounded" />
          <input data-music-volume type="range" min="0" max="100" step="1" value="70" aria-label="音量" />
        </label>
      </div>
    </div>

    <div class="azure-music-library">
      <div class="azure-music-tabs" role="tablist" aria-label="音乐信息">
        <button type="button" role="tab" aria-selected="true" data-music-tab="lyrics">歌词</button>
        <button type="button" role="tab" aria-selected="false" data-music-tab="playlist">歌单</button>
      </div>

      <div class="azure-music-pane" role="tabpanel" data-music-pane="lyrics">
        <div class="azure-music-lyrics" data-music-lyrics>
          <p class="azure-music-empty">{azureContent.musicPage.emptyLyrics}</p>
        </div>
      </div>

      <div class="azure-music-pane" role="tabpanel" data-music-pane="playlist" hidden>
        <ol class="azure-music-playlist" data-music-playlist></ol>
      </div>
    </div>
  </div>
</section>

<script>
  type MusicTrack = {
    name: string;
    artist: string;
    url: string;
    pic?: string;
    lrc?: string;
  };

  type LyricLine = { time: number; text: string };

  function initAzureMusicPage() {
    const root = document.querySelector<HTMLElement>("[data-azure-music-page]");
    const manager = window.__fireflyMusic;
    if (!root || !manager) return;
		const musicManager = manager;

    window.__azureMusicPageController?.abort();
    const controller = new AbortController();
    window.__azureMusicPageController = controller;
    const { signal } = controller;

    // 这些节点由同一组件静态输出；非空断言让闭包中的类型保持稳定。
    const cover = root.querySelector<HTMLImageElement>("[data-music-cover]")!;
    const disc = root.querySelector<HTMLElement>("[data-music-disc]")!;
    const title = root.querySelector<HTMLElement>("[data-music-title]")!;
    const artist = root.querySelector<HTMLElement>("[data-music-artist]")!;
    const progress = root.querySelector<HTMLInputElement>("[data-music-progress]")!;
    const current = root.querySelector<HTMLElement>("[data-music-current]")!;
    const duration = root.querySelector<HTMLElement>("[data-music-duration]")!;
    const volume = root.querySelector<HTMLInputElement>("[data-music-volume]")!;
    const playButton = root.querySelector<HTMLButtonElement>("[data-music-play]")!;
    const modeButton = root.querySelector<HTMLButtonElement>("[data-music-mode]")!;
    const lyricsRoot = root.querySelector<HTMLElement>("[data-music-lyrics]")!;
    const playlistRoot = root.querySelector<HTMLOListElement>("[data-music-playlist]")!;

    function renderTrack(track: MusicTrack | null, index: number) {
      if (!track) return;
      title.textContent = track.name;
      artist.textContent = track.artist;
      if (track.pic) {
        cover.src = track.pic;
        cover.alt = `${track.name} - ${track.artist}`;
      }
      playlistRoot.querySelectorAll("button").forEach((button, buttonIndex) => {
        button.setAttribute("aria-current", buttonIndex === index ? "true" : "false");
      });
    }

    function renderPlaylist(items: MusicTrack[], currentIndex: number) {
      playlistRoot.replaceChildren();
      items.forEach((track, index) => {
        const item = document.createElement("li");
        const button = document.createElement("button");
        const number = document.createElement("span");
        const copy = document.createElement("span");
        const name = document.createElement("strong");
        const by = document.createElement("small");
        number.textContent = String(index + 1).padStart(2, "0");
        name.textContent = track.name;
        by.textContent = track.artist;
        copy.append(name, by);
        button.append(number, copy);
        button.type = "button";
        button.setAttribute("aria-label", `播放 ${track.name}`);
        button.setAttribute("aria-current", index === currentIndex ? "true" : "false");
        button.addEventListener("click", () => musicManager.playTrackByIndex(index), { signal });
        item.append(button);
        playlistRoot.append(item);
      });
    }

    function renderLyrics(lines: LyricLine[], status = "loaded") {
      lyricsRoot.replaceChildren();
      if (!lines.length) {
        const empty = document.createElement("p");
        empty.className = "azure-music-empty";
        empty.textContent = status === "loading" ? "歌词正在浮现……" : "这首歌暂时没有歌词，旋律仍会继续。";
        lyricsRoot.append(empty);
        return;
      }
      lines.forEach((line, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = line.text;
        button.dataset.lyricIndex = String(index);
        button.addEventListener("click", () => musicManager.seekToTime(line.time), { signal });
        lyricsRoot.append(button);
      });
    }

    function updatePlayState(isPlaying: boolean) {
      playButton.dataset.playing = String(isPlaying);
      playButton.setAttribute("aria-label", isPlaying ? "暂停" : "播放");
      disc.dataset.playing = String(isPlaying);
    }

    function updateMode(mode: number) {
      const labels = ["列表循环", "单曲循环", "随机播放"];
      modeButton.title = labels[mode] ?? labels[0];
      modeButton.dataset.mode = String(mode);
    }

    function hydrate() {
      const state = musicManager.getState();
      renderPlaylist(state.playlist || [], state.currentIndex || 0);
      renderTrack(state.track, state.currentIndex || 0);
      renderLyrics(state.lyrics || [], state.lyrics?.length ? "loaded" : "none");
      updatePlayState(state.isPlaying);
      updateMode(state.playMode);
      progress.value = String(state.progress || 0);
      current.textContent = state.currentTimeStr || "0:00";
      duration.textContent = state.durationStr || "0:00";
      volume.value = String(Math.round((state.volume ?? 0.7) * 100));
    }

    root.querySelectorAll<HTMLButtonElement>("[data-music-tab]").forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.musicTab;
        root.querySelectorAll<HTMLButtonElement>("[data-music-tab]").forEach((item) => item.setAttribute("aria-selected", String(item === tab)));
        root.querySelectorAll<HTMLElement>("[data-music-pane]").forEach((pane) => { pane.hidden = pane.dataset.musicPane !== target; });
      }, { signal });
    });

    playButton.addEventListener("click", () => musicManager.togglePlay(), { signal });
    root.querySelector("[data-music-prev]")?.addEventListener("click", () => musicManager.playPrev(), { signal });
    root.querySelector("[data-music-next]")?.addEventListener("click", () => musicManager.playNext(), { signal });
    modeButton.addEventListener("click", () => musicManager.cyclePlayMode(), { signal });
    progress.addEventListener("input", () => musicManager.seek(Number(progress.value) / 100), { signal });
    volume.addEventListener("input", () => musicManager.setVolume(Number(volume.value) / 100), { signal });

    window.addEventListener("fm:init", (event: Event) => {
      const detail = (event as CustomEvent).detail;
      renderPlaylist(detail.playlist || [], musicManager.getState().currentIndex || 0);
      hydrate();
    }, { signal });
    window.addEventListener("fm:track", (event: Event) => {
      const detail = (event as CustomEvent).detail;
      renderTrack(detail.track, detail.index);
    }, { signal });
    window.addEventListener("fm:lyrics", (event: Event) => {
      const detail = (event as CustomEvent).detail;
      renderLyrics(detail.lyrics || [], detail.status);
    }, { signal });
    window.addEventListener("fm:play-state", (event: Event) => updatePlayState((event as CustomEvent).detail.isPlaying), { signal });
    window.addEventListener("fm:mode", (event: Event) => updateMode((event as CustomEvent).detail.playMode), { signal });
    window.addEventListener("fm:volume", (event: Event) => { volume.value = String(Math.round(((event as CustomEvent).detail.volume ?? 0) * 100)); }, { signal });
    window.addEventListener("fm:time", (event: Event) => {
      const detail = (event as CustomEvent).detail;
      progress.value = String(detail.progress || 0);
      current.textContent = detail.currentTimeStr || "0:00";
      duration.textContent = detail.durationStr || "0:00";
    }, { signal });
    window.addEventListener("fm:lrc-index", (event: Event) => {
      const index = (event as CustomEvent).detail.index;
      lyricsRoot.querySelectorAll("button").forEach((line, lineIndex) => line.setAttribute("aria-current", lineIndex === index ? "true" : "false"));
      const active = lyricsRoot.querySelector<HTMLElement>(`[data-lyric-index="${index}"]`);
      active?.scrollIntoView({ block: "center", behavior: "smooth" });
    }, { signal });

    musicManager.init();
    hydrate();
  }

  document.addEventListener("DOMContentLoaded", initAzureMusicPage, { once: true });
  document.addEventListener("astro:page-load", initAzureMusicPage);
  if (document.readyState !== "loading") initAzureMusicPage();
</script>
