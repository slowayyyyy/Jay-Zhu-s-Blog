---
import { siteConfig } from '../data/site';

const title = siteConfig.opening.title;
const openingVideo = siteConfig.opening.video;
const hasOpeningVideo = Boolean(openingVideo?.enabled && openingVideo.src?.trim());
const openingSubtitles = openingVideo?.subtitles;
const hasOpeningSubtitles = Boolean(
	hasOpeningVideo && openingSubtitles?.enabled && openingSubtitles.src?.trim(),
);
const sceneWidth = 3840;
const sceneHeight = 2160;

type SceneLayer = {
	src: string;
	x: number;
	y: number;
	width: number;
	height: number;
	kind: 'lantern' | 'water' | 'grass';
	duration: number;
	delay?: number;
	sway?: number;
	scaleX?: number;
	scaleY?: number;
};

const layers: SceneLayer[] = [
	{ src: 'lamp-06.webp', x: 1198.5, y: 884, width: 175, height: 320, kind: 'lantern', duration: 7.8, sway: 1.1 },
	{ src: 'lamp-04.webp', x: 2592.5, y: 1027, width: 335, height: 376, kind: 'lantern', duration: 9.4, delay: -3.2, sway: 0.8 },
	{ src: 'lamp-03.webp', x: 527.5, y: 682.5, width: 247, height: 253, kind: 'lantern', duration: 8.8, delay: -5.1, sway: 0.7 },
	{ src: 'lamp-main.webp', x: 3577.5, y: 1061, width: 525, height: 544, kind: 'lantern', duration: 6.6, delay: -1.4, sway: 1.15 },
	{ src: 'grass.webp', x: 521, y: 302, width: 744, height: 524, kind: 'grass', duration: 8.2 },
	{ src: 'lamp-01.webp', x: 2991.11182, y: 838.11035, width: 261, height: 278, kind: 'lantern', duration: 7.1, delay: -4.2, sway: 0.8 },
	{ src: 'water-02.webp', x: 1304, y: 391.5, width: 1494, height: 161, kind: 'water', duration: 10.5, delay: -3 },
	{ src: 'water.webp', x: 1952.5, y: 204, width: 3009, height: 408, kind: 'water', duration: 13, delay: -7 },
	{ src: 'lamp-01.webp', x: 2576.15186, y: 1989.16296, width: 261, height: 278, kind: 'lantern', duration: 10.2, delay: -5.8, sway: 0.65 },
	{ src: 'lamp-07.webp', x: 3094.92773, y: 1234.80652, width: 226, height: 241, kind: 'lantern', duration: 7.6, delay: -2.7, sway: 0.9 },
	{ src: 'lamp-08.webp', x: 1406.20544, y: 1908.69177, width: 266, height: 289, kind: 'lantern', duration: 9.8, delay: -6.3, sway: 0.75 },
	{ src: 'lamp-09.webp', x: 3274.36963, y: 1498.49792, width: 291, height: 430, kind: 'lantern', duration: 6.2, delay: -3.6, sway: 1.25 },
	{ src: 'lamp-10.webp', x: 1618.08203, y: 1820.54004, width: 266, height: 302, kind: 'lantern', duration: 6.8, delay: -1.7, sway: 1.1 },
	{ src: 'lamp-11.webp', x: 882.14618, y: 1653.88574, width: 231, height: 305, kind: 'lantern', duration: 7.4, delay: -4.8, sway: 1.2 },
	{ src: 'lamp-12.webp', x: 2808.15186, y: 1479.16296, width: 283, height: 304, kind: 'lantern', duration: 6.5, delay: -5.4, sway: 1.15 },
	{ src: 'lamp-13.webp', x: 2499.51245, y: 1782.32666, width: 270, height: 295, kind: 'lantern', duration: 8.7, delay: -2.1, sway: 0.85 },
	{ src: 'lamp-15.webp', x: 252.0979, y: 1151.18518, width: 258, height: 285, kind: 'lantern', duration: 7.2, delay: -5.9, sway: 1.35 },
	{ src: 'lamp-16.webp', x: 1506.77124, y: 1397.37537, width: 195, height: 216, kind: 'lantern', duration: 9.7, delay: -7.4, sway: 0.7 },
	{ src: 'lamp-18.webp', x: 1848.94153, y: 1303.96985, width: 267, height: 293, kind: 'lantern', duration: 7.9, delay: -1.2, sway: 1, scaleX: 1.14687, scaleY: 1.17624 },
	{ src: 'lamp-19.webp', x: 2884.38477, y: 1973.50476, width: 359, height: 349, kind: 'lantern', duration: 7.1, delay: -4.4, sway: 1.25 },
	{ src: 'lamp-20.webp', x: 282.23547, y: 1728.36133, width: 301, height: 327, kind: 'lantern', duration: 8.3, delay: -2.9, sway: 1.2 },
	{ src: 'lamp-14.webp', x: 2136, y: 2024, width: 312, height: 272, kind: 'lantern', duration: 9.2, delay: -6.1, sway: 0.75 },
];

const layerStyle = (layer: SceneLayer, index: number) => {
	const width = layer.width * (layer.scaleX ?? 1);
	const height = layer.height * (layer.scaleY ?? 1);
	const left = ((layer.x - width / 2) / sceneWidth) * 100;
	const top = ((sceneHeight - layer.y - height / 2) / sceneHeight) * 100;

	return [
		`left:${left}%`,
		`top:${top}%`,
		`width:${(width / sceneWidth) * 100}%`,
		`height:${(height / sceneHeight) * 100}%`,
		`--duration:${layer.duration}s`,
		`--delay:${layer.delay ?? 0}s`,
		`--sway:${layer.sway ?? 0.8}deg`,
		`--light-index:${index}`,
	].join(';');
};

const embers = Array.from({ length: 22 }, (_, index) => ({
	left: 4 + ((index * 37) % 92),
	top: 52 + ((index * 19) % 43),
	delay: -((index * 0.73) % 7),
	duration: 5.5 + (index % 6) * 0.7,
	size: 2 + (index % 4),
}));

const transitionSparks = Array.from({ length: 18 }, (_, index) => {
	const angle = (Math.PI * 2 * index) / 18 + (index % 2) * 0.12;
	const distance = 72 + (index % 5) * 22;

	return {
		x: Math.cos(angle) * distance,
		y: Math.sin(angle) * distance,
		delay: (index % 6) * 26,
		size: 2 + (index % 3),
	};
});
---

<section class="opening-overlay" id="opening-overlay" aria-label="博客起始页">
	<div class="opening-visual">
		{
			hasOpeningVideo && (
				<video
					class="opening-video"
					id="opening-video"
					data-src={openingVideo.src.trim()}
					data-poster={openingVideo.poster || undefined}
					preload="none"
					playsinline
				>
					{
						hasOpeningSubtitles && (
							<track
								id="opening-video-subtitle-track"
								kind="subtitles"
								src={openingSubtitles.src.trim()}
								srclang="ja"
								label="日本語 / 中文"
								default
							/>
						)
					}
				</video>
			)
		}
		<div class="wallpaper-scene" aria-hidden="true">
			<img
				class="scene-background"
				data-src="/images/lantern-scene/background.webp"
				alt=""
			/>
			{
				layers.map((layer, index) => (
					<img
						class:list={['scene-layer', `scene-${layer.kind}`]}
						data-src={`/images/lantern-scene/${layer.src}`}
						alt=""
						style={layerStyle(layer, index)}
						draggable="false"
					/>
				))
			}
			<div class="scene-embers">
				{
					embers.map((ember) => (
						<span
							style={`left:${ember.left}%;top:${ember.top}%;--delay:${ember.delay}s;--duration:${ember.duration}s;--size:${ember.size}px`}
						/>
					))
				}
			</div>
		</div>
		<div class="opening-shade" />
		<div class="opening-grain" />

		<div class="opening-content">
			<p class="opening-kicker">{siteConfig.opening.kicker}</p>
			<h1 class="opening-title" id="opening-title" aria-label={title}>
				{
					[...title].map((character, index) => (
						<span style={`--char-index:${index};--ignite-order:${Math.abs(index - (title.length - 1) / 2)}`}>
							{character}
						</span>
					))
				}
			</h1>
			<div class="title-rule" aria-hidden="true"><span /></div>
			<p class="opening-caption">{siteConfig.opening.caption}</p>
			<div class="opening-actions">
				<button type="button" class="enter-button" id="enter-blog">
					<span data-copy="common.enter">进入博客</span>
					<span class="enter-arrow" aria-hidden="true">↓</span>
				</button>
				{
					hasOpeningVideo && (
						<button type="button" class="video-start-button" id="play-opening-video">
							<span class="video-play-mark" aria-hidden="true">▶</span>
							<span>
								<strong>{openingVideo.playLabel}</strong>
								{openingVideo.sizeLabel && <small>{openingVideo.sizeLabel}</small>}
							</span>
						</button>
					)
				}
			</div>
		</div>

		<p class="opening-coordinate" aria-hidden="true">{siteConfig.opening.coordinate}</p>

		{
			hasOpeningVideo && (
				<div
					class="opening-video-interface"
					id="opening-video-interface"
					aria-hidden="true"
					inert
				>
					<div class="video-topbar">
						<span>ORIGINAL SOUND · CINEMA OPENING</span>
						<button type="button" id="skip-opening-video">{openingVideo.skipLabel}</button>
					</div>
					<p class="video-loading-status" id="video-loading-status">{openingVideo.loadingLabel}</p>
					<div class="video-controls">
						<button type="button" id="toggle-opening-video" aria-label="播放或暂停视频">Ⅱ</button>
						<span id="opening-video-current">0:00</span>
						<input
							type="range"
							id="opening-video-progress"
							min="0"
							max="1000"
							value="0"
							aria-label="视频播放进度"
						/>
						<span id="opening-video-duration">5:22</span>
						{
							hasOpeningSubtitles && (
								<button
									type="button"
									id="toggle-opening-subtitles"
									aria-label="显示或隐藏字幕"
									data-on-label={openingSubtitles.toggleLabel || '字幕'}
									data-off-label={openingSubtitles.offLabel || '字幕关'}
								>
									{openingSubtitles.toggleLabel || '字幕'}
								</button>
							)
						}
						<button type="button" id="mute-opening-video" aria-label="静音或恢复声音">原声</button>
					</div>
				</div>
			)
		}

		{
			hasOpeningSubtitles && (
				<div class="opening-subtitles" id="opening-subtitles" aria-hidden="true">
					{[0, 1].map((layerIndex) => (
						<div class="subtitle-layer" data-subtitle-layer={layerIndex}>
							<p class="subtitle-japanese" />
							<p class="subtitle-chinese" />
							<div class="subtitle-dust">
								{Array.from({ length: 12 }, (_, index) => (
									<i style={`--dust-index:${index};--dust-x:${(index * 23) % 97}%;--dust-delay:${(index % 6) * 32}ms`} />
								))}
							</div>
						</div>
					))}
				</div>
			)
		}
	</div>

	<div class="ignition-effects" aria-hidden="true">
		<div class="ignition-rays" />
		<div class="ignition-bloom" />
		<div class="ignition-thread" />
		<div class="ignition-ring ignition-ring-one" />
		<div class="ignition-ring ignition-ring-two" />
		<div class="ignition-core" />
		<div class="ignition-sparks">
			{
				transitionSparks.map((spark) => (
					<span
						style={`--spark-x:${spark.x}px;--spark-y:${spark.y}px;--spark-delay:${spark.delay}ms;--spark-size:${spark.size}px`}
					/>
				))
			}
		</div>
	</div>
</section>

<script is:inline data-astro-rerun>
	(() => {
		const overlay = document.getElementById('opening-overlay');
		const enterButton = document.getElementById('enter-blog');
		const openingTitle = document.getElementById('opening-title');
		const video = document.getElementById('opening-video');
		const playVideoButton = document.getElementById('play-opening-video');
		const skipVideoButton = document.getElementById('skip-opening-video');
		const toggleVideoButton = document.getElementById('toggle-opening-video');
		const muteVideoButton = document.getElementById('mute-opening-video');
		const toggleSubtitleButton = document.getElementById('toggle-opening-subtitles');
		const videoProgress = document.getElementById('opening-video-progress');
		const videoCurrent = document.getElementById('opening-video-current');
		const videoDuration = document.getElementById('opening-video-duration');
		const videoStatus = document.getElementById('video-loading-status');
		const videoInterface = document.getElementById('opening-video-interface');
		const subtitleTrackElement = document.getElementById('opening-video-subtitle-track');
		const subtitleRoot = document.getElementById('opening-subtitles');
		const subtitleLayers = subtitleRoot
			? [...subtitleRoot.querySelectorAll('[data-subtitle-layer]')]
			: [];

		if (overlay && enterButton) {
			if (sessionStorage.getItem('jay-intro-seen-lantern')) {
				document.body.classList.remove('intro-active');
				document.body.classList.remove('intro-transition');
				overlay.remove();
			} else {
				overlay.querySelectorAll('img[data-src]').forEach((image) => {
					if (!(image instanceof HTMLImageElement)) return;
					image.src = image.dataset.src || '';
				});
				if (video instanceof HTMLVideoElement && video.dataset.poster) {
					video.poster = video.dataset.poster;
				}

				let isEntering = false;
				let fallbackTimer;
				let musicStarted = false;
				let videoUiTimer;
				let activeSubtitleLayer;
				let subtitleTransitionId = 0;
				let subtitlesVisible = localStorage.getItem('jay-opening-subtitles') !== 'off';

				const formatTime = (seconds) => {
					if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
					const minutes = Math.floor(seconds / 60);
					return `${minutes}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`;
				};

				const startBlogMusic = () => {
					if (musicStarted) return;
					musicStarted = true;
					window.dispatchEvent(new CustomEvent('jay:intro-enter'));
					document.dispatchEvent(new CustomEvent('jay:intro-enter'));
				};

				const fadeOutVideoAudio = () => {
					if (!(video instanceof HTMLVideoElement) || video.paused || video.muted || video.volume === 0) {
						if (video instanceof HTMLVideoElement) video.pause();
						startBlogMusic();
						return;
					}

					const startedAt = performance.now();
					const initialVolume = video.volume;
					const fadeDuration = 900;
					const fade = (now) => {
						const progress = Math.min(1, (now - startedAt) / fadeDuration);
						video.volume = initialVolume * (1 - progress);
						if (progress < 1 && !video.paused) {
							requestAnimationFrame(fade);
							return;
						}
						video.pause();
						startBlogMusic();
					};
					requestAnimationFrame(fade);
				};

				const updateVideoProgress = () => {
					if (!(video instanceof HTMLVideoElement)) return;
					if (videoCurrent) videoCurrent.textContent = formatTime(video.currentTime);
					if (videoDuration && Number.isFinite(video.duration)) {
						videoDuration.textContent = formatTime(video.duration);
					}
					if (
						videoProgress instanceof HTMLInputElement &&
						Number.isFinite(video.duration) &&
						video.duration > 0
					) {
						videoProgress.value = String(Math.round((video.currentTime / video.duration) * 1000));
					}
				};

				const showVideoUi = () => {
					clearTimeout(videoUiTimer);
					overlay.classList.remove('is-video-ui-hidden');
				};

				const setVideoInterfaceAvailable = (available) => {
					if (!(videoInterface instanceof HTMLElement)) return;
					videoInterface.toggleAttribute('inert', !available);
					videoInterface.setAttribute('aria-hidden', String(!available));
				};

				const scheduleVideoUiHide = () => {
					showVideoUi();
					if (!(video instanceof HTMLVideoElement) || video.paused || isEntering) return;
					videoUiTimer = setTimeout(() => {
						if (!video.paused && !isEntering) overlay.classList.add('is-video-ui-hidden');
					}, 2000);
				};

				const clearSubtitleLayer = (layer) => {
					layer.classList.remove('is-active', 'is-leaving');
					const japanese = layer.querySelector('.subtitle-japanese');
					const chinese = layer.querySelector('.subtitle-chinese');
					if (japanese) japanese.textContent = '';
					if (chinese) chinese.textContent = '';
				};

				const showSubtitle = (japaneseText = '', chineseText = '') => {
					const transitionId = ++subtitleTransitionId;
					const previousLayer = activeSubtitleLayer;
					if (previousLayer) previousLayer.classList.add('is-leaving');

					if (!subtitlesVisible || (!japaneseText && !chineseText) || subtitleLayers.length === 0) {
						activeSubtitleLayer = undefined;
						if (previousLayer) {
							setTimeout(() => {
								if (transitionId === subtitleTransitionId || previousLayer !== activeSubtitleLayer) {
									clearSubtitleLayer(previousLayer);
								}
							}, 720);
						}
						return;
					}

					const nextLayer = subtitleLayers.find((layer) => layer !== previousLayer) || subtitleLayers[0];
					clearSubtitleLayer(nextLayer);
					const japanese = nextLayer.querySelector('.subtitle-japanese');
					const chinese = nextLayer.querySelector('.subtitle-chinese');
					if (japanese) japanese.textContent = japaneseText;
					if (chinese) chinese.textContent = chineseText;
					nextLayer.classList.add('is-active');
					activeSubtitleLayer = nextLayer;

					if (previousLayer && previousLayer !== nextLayer) {
						setTimeout(() => {
							if (previousLayer !== activeSubtitleLayer) clearSubtitleLayer(previousLayer);
						}, 720);
					}
				};

				const syncSubtitleCue = () => {
					if (!(subtitleTrackElement instanceof HTMLTrackElement)) return;
					const activeCue = subtitleTrackElement.track.activeCues?.[0];
					const cueText = activeCue && 'text' in activeCue ? String(activeCue.text) : '';
					const lines = cueText
						.split(/\r?\n/)
						.map((line) => line.replace(/<[^>]+>/g, '').trim())
						.filter(Boolean);
					showSubtitle(lines[0] || '', lines.slice(1).join(' '));
				};

				const applySubtitleVisibility = () => {
					overlay.classList.toggle('are-subtitles-hidden', !subtitlesVisible);
					if (toggleSubtitleButton) {
						toggleSubtitleButton.textContent = subtitlesVisible
							? toggleSubtitleButton.dataset.onLabel || '字幕'
							: toggleSubtitleButton.dataset.offLabel || '字幕关';
						toggleSubtitleButton.setAttribute('aria-pressed', String(subtitlesVisible));
					}
					if (subtitlesVisible) {
						syncSubtitleCue();
					} else {
						showSubtitle();
					}
				};

				const finishTransition = () => {
					if (!isEntering || !overlay.isConnected) return;
					clearTimeout(fallbackTimer);
					if (video instanceof HTMLVideoElement) video.pause();
					document.documentElement.dataset.introSeen = 'seen';
					document.body.classList.remove('intro-active', 'intro-transition');
					overlay.remove();
				};

				const enterBlog = (triggerButton = enterButton) => {
					if (isEntering) return;
					isEntering = true;

					const buttonRect = triggerButton.getBoundingClientRect();
					const titleRect = openingTitle?.getBoundingClientRect() ?? buttonRect;
					const sparkX = buttonRect.left + buttonRect.width / 2;
					const sparkY = buttonRect.top + buttonRect.height / 2;
					const isVideoActive = overlay.classList.contains('is-video-active');
					const igniteX = isVideoActive ? window.innerWidth / 2 : titleRect.left + titleRect.width / 2;
					const igniteY = isVideoActive ? window.innerHeight / 2 : titleRect.top + titleRect.height / 2;

					overlay.style.setProperty('--spark-x', `${sparkX}px`);
					overlay.style.setProperty('--spark-y', `${sparkY}px`);
					overlay.style.setProperty('--ignite-x', `${igniteX}px`);
					overlay.style.setProperty('--ignite-y', `${igniteY}px`);
					overlay.style.setProperty('--thread-height', `${Math.max(0, sparkY - igniteY)}px`);

					sessionStorage.setItem('jay-intro-seen-lantern', '1');
					document.body.classList.add('intro-transition');
					overlay.classList.add('is-igniting');
					document.body.classList.remove('intro-active');

					if (isVideoActive) {
						fadeOutVideoAudio();
					} else {
						startBlogMusic();
					}

					const visual = overlay.querySelector('.opening-visual');
					visual?.addEventListener('animationend', (event) => {
						if (event.target !== visual || event.animationName !== 'curtain-into-light') return;
						finishTransition();
					});
					fallbackTimer = setTimeout(finishTransition, 1700);
				};

				enterButton.addEventListener('click', () => enterBlog(enterButton));
				skipVideoButton?.addEventListener('click', () => enterBlog(skipVideoButton));

				if (video instanceof HTMLVideoElement && playVideoButton) {
					const loadingLabel = videoStatus?.textContent || '正在加载有声开场';

					if (subtitleTrackElement instanceof HTMLTrackElement) {
						subtitleTrackElement.track.mode = 'hidden';
						subtitleTrackElement.track.addEventListener('cuechange', syncSubtitleCue);
						subtitleTrackElement.addEventListener('load', () => {
							subtitleTrackElement.track.mode = 'hidden';
							syncSubtitleCue();
						});
						applySubtitleVisibility();
					}

					const startVideo = async () => {
						if (isEntering) return;
						setVideoInterfaceAvailable(true);
						overlay.classList.add('is-video-active', 'is-video-loading');
						showVideoUi();
						if (videoStatus) videoStatus.textContent = loadingLabel;

						if (!video.src) {
							video.src = video.dataset.src || '';
							video.load();
						}

						video.muted = false;
						video.volume = 0.82;

						try {
							await video.play();
							overlay.classList.remove('is-video-loading');
							overlay.classList.add('is-video-playing');
							scheduleVideoUiHide();
						} catch {
							overlay.classList.remove('is-video-loading', 'is-video-playing');
							overlay.classList.add('has-video-error');
							showVideoUi();
							if (videoStatus) videoStatus.textContent = '视频未能播放，请检查网络或视频存储';
						}
					};

					playVideoButton.addEventListener('click', startVideo);
					overlay.addEventListener('pointermove', scheduleVideoUiHide, { passive: true });
					overlay.addEventListener('pointerdown', scheduleVideoUiHide, { passive: true });
					overlay.addEventListener('keydown', scheduleVideoUiHide);
					overlay.addEventListener('focusin', showVideoUi);

					toggleVideoButton?.addEventListener('click', async () => {
						if (video.paused) {
							try {
								await video.play();
							} catch {
								if (videoStatus) videoStatus.textContent = '浏览器阻止了播放，请再次点击';
							}
							return;
						}
						video.pause();
					});

					muteVideoButton?.addEventListener('click', () => {
						video.muted = !video.muted;
						muteVideoButton.textContent = video.muted ? '静音' : '原声';
					});

					toggleSubtitleButton?.addEventListener('click', () => {
						subtitlesVisible = !subtitlesVisible;
						localStorage.setItem('jay-opening-subtitles', subtitlesVisible ? 'on' : 'off');
						applySubtitleVisibility();
					});

					videoProgress?.addEventListener('input', () => {
						if (!(videoProgress instanceof HTMLInputElement) || !Number.isFinite(video.duration)) return;
						video.currentTime = (Number(videoProgress.value) / 1000) * video.duration;
						updateVideoProgress();
					});

					video.addEventListener('loadedmetadata', updateVideoProgress);
					video.addEventListener('timeupdate', updateVideoProgress);
					video.addEventListener('waiting', () => overlay.classList.add('is-video-buffering'));
					video.addEventListener('playing', () => {
						overlay.classList.remove('is-video-loading', 'is-video-buffering', 'has-video-error');
						overlay.classList.add('is-video-playing');
						if (toggleVideoButton) toggleVideoButton.textContent = 'Ⅱ';
						scheduleVideoUiHide();
					});
					video.addEventListener('pause', () => {
						overlay.classList.remove('is-video-playing');
						if (toggleVideoButton) toggleVideoButton.textContent = '▶';
						showVideoUi();
					});
					video.addEventListener('error', () => {
						overlay.classList.remove('is-video-loading', 'is-video-buffering', 'is-video-playing');
						overlay.classList.add('has-video-error');
						showVideoUi();
						if (videoStatus) videoStatus.textContent = '视频加载失败，请检查视频存储或网络';
					});
					video.addEventListener('ended', () => enterBlog(skipVideoButton || enterButton));
				}
			}
		}
	})();
</script>

