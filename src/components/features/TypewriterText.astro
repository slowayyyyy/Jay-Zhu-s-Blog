---
export interface Props {
	text: string | string[];
	speed?: number;
	deleteSpeed?: number;
	pauseTime?: number;
	syncCarousel?: boolean;
	class?: string;
}

const {
	text,
	speed = 100,
	deleteSpeed = 50,
	pauseTime = 2000,
	syncCarousel = false,
	class: className = "",
} = Astro.props;
const textData = Array.isArray(text) ? JSON.stringify(text) : text;
---

<span
  class={`typewriter ${className}`}
  data-text={textData}
  data-speed={speed}
  data-delete-speed={deleteSpeed}
  data-pause-time={pauseTime}
  data-sync-carousel={syncCarousel}>{Array.isArray(text) ? text[0] : text}</span>

<script>
  import { TypewriterEffect } from "@/scripts/typewriter-controller";

  const instances = new Map<HTMLElement, TypewriterEffect>();
  function initTypewriterElements() {
    for (const [element, instance] of instances) {
      if (!element.isConnected) {
        instance.destroy();
        instances.delete(element);
      }
    }
    document.querySelectorAll<HTMLElement>(".typewriter").forEach((element) => {
      if (!instances.has(element)) instances.set(element, new TypewriterEffect(element));
    });
    window.dispatchEvent(new CustomEvent("hero:typewriter-ready"));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTypewriterElements, { once: true });
  } else initTypewriterElements();

  // Idempotent: multiple Swup lifecycle events must not restart the sentence.
  document.addEventListener("swup:contentReplaced", initTypewriterElements);
  document.addEventListener("swup:content:replace", initTypewriterElements);
  document.addEventListener("swup:page:view", initTypewriterElements);
  if (window.swup?.hooks) {
    window.swup.hooks.on("content:replace", initTypewriterElements);
    window.swup.hooks.on("page:view", initTypewriterElements);
  }
</script>

<style>
  .typewriter {
    display: inline-block;
    max-width: 100%;
    position: relative;
    overflow-wrap: anywhere;
  }

  .typewriter::after {
    content: "|";
    position: absolute;
    inset-inline-start: 100%;
    top: 0;
    animation: blink 1s infinite;
    margin-inline-start: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter::after { content: none; animation: none; }
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }
</style>
