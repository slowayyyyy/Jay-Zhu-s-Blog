---
import type { PostEntry } from '../lib/content';
import { getSectionSummary, getTagSummary, getYearSummary } from '../lib/content';

interface Props {
	posts: PostEntry[];
}

const { posts } = Astro.props;
const sections = getSectionSummary(posts);
const tags = (await getTagSummary(posts)).slice(0, 10);
const years = getYearSummary(posts);
---

<aside class="taxonomy-panel">
	<section class="taxonomy-section">
		<h3 data-copy="common.sections" />
		<div class="taxonomy-links">
			{
				sections.map((section) => (
					<a href={`/search/?section=${section.section}`}>
						<span data-copy={`section.${section.section}`}>{section.zh}</span>
						<strong>{section.count}</strong>
					</a>
				))
			}
		</div>
	</section>
	<section class="taxonomy-section">
		<h3 data-copy="common.tags" />
		<div class="tag-list">
			{
				tags.map(({ tag, label, count }) => (
					<a class="tag-chip" href={`/search/?tag=${encodeURIComponent(tag)}`}>
						#{label} <span>{count}</span>
					</a>
				))
			}
		</div>
	</section>
	<section class="taxonomy-section">
		<h3 data-copy="common.archive" />
		<div class="taxonomy-links">
			{
				years.map(({ year, count }) => (
					<a href={`/archive/${year}/`}>
						<span>{year}</span>
						<strong>{count}</strong>
					</a>
				))
			}
		</div>
	</section>
</aside>

<style>
	.taxonomy-panel {
		display: grid;
		gap: 2rem;
	}

	.taxonomy-section {
		padding-top: 1rem;
		border-top: 1px solid var(--line);
	}

	.taxonomy-section h3 {
		margin: 0 0 0.75rem;
		font-family: var(--font-serif);
		font-size: 1rem;
	}

	.taxonomy-links {
		display: grid;
		gap: 0;
	}

	.taxonomy-links a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 2.8rem;
		border-bottom: 1px solid var(--line);
		color: var(--text-soft);
		font-size: 0.86rem;
	}

	.taxonomy-links a:hover {
		color: var(--accent);
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.75rem;
	}

	.tag-list .tag-chip {
		min-height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--text-soft);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
	}

	.tag-list .tag-chip:hover {
		color: var(--accent);
		text-decoration-color: currentColor;
	}
</style>
