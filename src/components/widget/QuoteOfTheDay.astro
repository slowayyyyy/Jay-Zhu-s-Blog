---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";
import azureContent from "@/data/azure-content.json";
import { profileConfig } from "@/config/profileConfig";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style } = Astro.props;
const dailyQuotes = azureContent.dailyQuotes?.length > 0
	? azureContent.dailyQuotes
	: [{ text: "慢一点，也是在向前走。", author: profileConfig.name }];
---

<WidgetLayout
	id="quote-of-the-day"
	name="今日一言"
	class={className}
	style={style}
>
	<daily-quote data-quotes={JSON.stringify(dailyQuotes)}>
		<blockquote>
			<span class="quote-mark" aria-hidden="true">“</span>
			<span class="quote-text">{dailyQuotes[0].text}</span>
			<span class="quote-mark" aria-hidden="true">”</span>
		</blockquote>
		<cite class="quote-author">—— {dailyQuotes[0].author}</cite>
	</daily-quote>
</WidgetLayout>

<style>
	daily-quote {
		display: block;
		padding: 0.2rem 0.25rem 0.1rem;
	}

	blockquote {
		margin: 0;
		color: var(--content-regular);
		font-size: 0.9rem;
		font-style: italic;
		line-height: 1.75;
		transition: color 180ms ease;
	}

	daily-quote:hover blockquote {
		color: var(--primary);
	}

	.quote-mark {
		margin: 0 0.12rem;
		color: var(--primary);
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.45rem;
		font-style: normal;
		line-height: 0;
		opacity: 0.55;
		vertical-align: -0.12em;
	}

	.quote-author {
		display: block;
		margin-top: 0.55rem;
		color: var(--content-meta);
		font-size: 0.75rem;
		font-style: normal;
		text-align: right;
	}
</style>

<script>
	class DailyQuote extends HTMLElement {
		private midnightTimer?: number;
		private quotes: Array<{ text: string; author: string }> = [];

		connectedCallback() {
			try {
				this.quotes = JSON.parse(this.dataset.quotes || "[]");
			} catch {
				this.quotes = [];
			}
			this.showTodayQuote();
			this.scheduleMidnightRefresh();
		}

		disconnectedCallback() {
			if (this.midnightTimer) window.clearTimeout(this.midnightTimer);
		}

		private showTodayQuote() {
			if (this.quotes.length === 0) return;
			const now = new Date();
			const dayNumber = Math.floor(
				Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) /
					86_400_000,
			);
			const quoteIndex = dayNumber % this.quotes.length;
			const { text, author } = this.quotes[quoteIndex];
			const textElement = this.querySelector<HTMLElement>(".quote-text");
			const authorElement =
				this.querySelector<HTMLElement>(".quote-author");

			if (textElement) textElement.textContent = text;
			if (authorElement) authorElement.textContent = `—— ${author}`;
		}

		private scheduleMidnightRefresh() {
			const now = new Date();
			const nextMidnight = new Date(
				now.getFullYear(),
				now.getMonth(),
				now.getDate() + 1,
			);
			const delay = nextMidnight.getTime() - now.getTime() + 100;

			this.midnightTimer = window.setTimeout(() => {
				this.showTodayQuote();
				this.scheduleMidnightRefresh();
			}, delay);
		}
	}

	if (!customElements.get("daily-quote")) {
		customElements.define("daily-quote", DailyQuote);
	}
</script>
