---
import type { CollectionEntry } from 'astro:content';
import { getTagLabel, getTagMap } from '../lib/content';
import {
	addDays,
	formatShanghaiDayKey,
	getCheckinDayKey,
	getCheckinDurationMinutes,
	getCheckinHabitId,
	getMonthCalendar,
	getWeekStart,
} from '../lib/checkin-metrics';
import { renderMarkdownContent } from '../lib/markdown';
import { siteConfig } from '../data/site';

interface Props {
	checkins: CollectionEntry<'checkins'>[];
}

interface BilingualCopy {
	zh: string;
	en: string;
}

interface HabitConfig {
	id: string;
	name: BilingualCopy;
	code: string;
	color: string;
	weeklyGoal: number;
	minimumMinutes: number;
	enabled?: boolean;
}

interface HabitMetric {
	count: number;
	minutes: number;
}

type HabitDaySummary = Record<string, HabitMetric>;

const { checkins } = Astro.props;
const tagMap = await getTagMap();
const renderedBodies = new Map(
	await Promise.all(
		checkins.map(async (checkin) => [
			checkin.id,
			(await renderMarkdownContent(checkin.body ?? '', checkin.data)).code.trim(),
		] as const),
	),
);

const todayKey = formatShanghaiDayKey();
const currentMonthKey = todayKey.slice(0, 7);
const weekStart = getWeekStart(todayKey);
const currentWeekDays = new Set(Array.from({ length: 7 }, (_, index) => addDays(weekStart, index)));
const defaultHabits: HabitConfig[] = [
	{
		id: 'english',
		name: { zh: '英语学习', en: 'English' },
		code: 'EN',
		color: '#e3a34f',
		weeklyGoal: 5,
		minimumMinutes: 5,
	},
	{
		id: 'exercise',
		name: { zh: '运动锻炼', en: 'Exercise' },
		code: 'MOVE',
		color: '#4d9b91',
		weeklyGoal: 3,
		minimumMinutes: 10,
	},
];
const configuredHabits = siteConfig.checkinSettings?.habits;
const seenHabitIds = new Set<string>();
const habits: HabitConfig[] = (Array.isArray(configuredHabits) ? configuredHabits : defaultHabits)
	.flatMap((item, index) => {
		const id = String(item?.id ?? '').trim().toLowerCase();
		const zh = String(item?.name?.zh ?? '').trim();
		if (!id || !zh || item?.enabled === false || seenHabitIds.has(id)) return [];
		seenHabitIds.add(id);
		const fallback = defaultHabits.find((habit) => habit.id === id) ?? defaultHabits[index % 2];
		return [{
			id,
			name: {
				zh,
				en: String(item?.name?.en ?? '').trim() || zh,
			},
			code: String(item?.code ?? '').trim().toUpperCase() || id.slice(0, 4).toUpperCase(),
			color: /^#[0-9a-f]{6}$/i.test(String(item?.color ?? '')) ? String(item.color) : fallback.color,
			weeklyGoal: Math.min(7, Math.max(1, Number(item?.weeklyGoal) || fallback.weeklyGoal)),
			minimumMinutes: Math.max(1, Number(item?.minimumMinutes) || fallback.minimumMinutes),
		}];
	});
if (habits.length === 0) habits.push(...defaultHabits);
const habitMap = new Map(habits.map((habit) => [habit.id, habit]));
const otherHabit: HabitConfig = {
	id: 'other',
	name: { zh: '其他记录', en: 'Other' },
	code: 'OTHER',
	color: '#82919a',
	weeklyGoal: 1,
	minimumMinutes: 1,
};
const getHabit = (habitId: string) => habitMap.get(habitId) ?? otherHabit;
const getMetric = (summary: HabitDaySummary, habitId: string): HabitMetric =>
	summary[habitId] ?? { count: 0, minutes: 0 };

const defaults = {
	pageKicker: 'LIGHT THE DAY',
	pageTitle: { zh: '灯火计划', en: 'Lamp Plan' },
	pageIntro: { zh: '不追求完美连续，只把今天真正做过的事点亮。', en: 'No perfect streaks, only the things you truly did today.' },
	todayLabel: { zh: '今天', en: 'Today' },
	quickKicker: '20 SECOND CHECK-IN',
	quickTitle: { zh: '今天，想点亮哪一盏灯？', en: 'Which lamp will you light today?' },
	quickIntro: { zh: '哪怕只完成最低行动，也算认真开始。', en: 'Even the minimum action counts as a real start.' },
	quickAction: { zh: '快速记录 →', en: 'Quick check-in →' },
	weekRemaining: { zh: '本周再点亮 {count} 天', en: '{count} more day(s) this week' },
	weekComplete: { zh: '本周目标已经完成', en: 'Weekly goal complete' },
	minimumLabel: { zh: '最低行动 {minutes} 分钟', en: 'Minimum {minutes} min' },
	timeKicker: 'TIME LEDGER',
	timeTitle: { zh: '时间账本', en: 'Time Ledger' },
	timeIntro: { zh: '按模块回看时间真正流向了哪里。', en: 'See where your time actually went, one habit at a time.' },
	timeMonthTotal: { zh: '本月总投入', en: 'Total this month' },
	timeWeekLabel: { zh: '本周', en: 'This week' },
	timeMonthLabel: { zh: '本月', en: 'This month' },
	timeGoalLabel: { zh: '月度基准 {minutes} 分钟', en: 'Monthly baseline {minutes} min' },
	timeTotalLabel: { zh: '累计', en: 'All time' },
	timeSessionsLabel: { zh: '{count} 次计时记录', en: '{count} timed sessions' },
	timeAverageLabel: { zh: '平均 {minutes} 分钟 / 次', en: '{minutes} min per session' },
	timeEmptyLabel: { zh: '尚未记录时长', en: 'No timed sessions yet' },
	timeUnit: { zh: '分钟', en: 'min' },
	calendarKicker: 'LAMP CALENDAR',
	calendarTitle: { zh: '灯火日历', en: 'Lamp Calendar' },
	statsLamps: { zh: '点亮灯数', en: 'Lamps lit' },
	statsDays: { zh: '行动天数', en: 'Active days' },
	statsMinutes: { zh: '记录分钟', en: 'Minutes logged' },
	recordsKicker: 'FIELD NOTES',
	recordsTitle: { zh: '所有记录', en: 'All Notes' },
	recordsSummary: { zh: '本月已经行动 {days} 天，点亮 {lights} 盏灯。', en: '{days} active days and {lights} lamps lit this month.' },
	listTitle: { zh: '全部记录', en: 'All records' },
};
const copy = { ...defaults, ...(siteConfig.checkinSettings?.copy ?? {}) };
const fillTemplate = (template: string, values: Record<string, string | number>) =>
	Object.entries(values).reduce(
		(result, [key, value]) => result.replaceAll(`{${key}}`, String(value)),
		template,
	);

const enrichedCheckins = checkins.map((checkin) => ({
	checkin,
	dayKey: getCheckinDayKey(checkin),
	habitId: getCheckinHabitId(checkin),
	durationMinutes: getCheckinDurationMinutes(checkin),
}));
const firstCheckinIdByDay = new Map<string, string>();
for (const { checkin, dayKey } of enrichedCheckins) {
	if (!firstCheckinIdByDay.has(dayKey)) firstCheckinIdByDay.set(dayKey, checkin.id);
}
const activityByDay = new Map<string, HabitDaySummary>();

for (const { dayKey, habitId, durationMinutes } of enrichedCheckins) {
	const summary = activityByDay.get(dayKey) ?? {};
	const current = getMetric(summary, habitId);
	summary[habitId] = {
		count: current.count + 1,
		minutes: current.minutes + durationMinutes,
	};
	activityByDay.set(dayKey, summary);
}

const completedDaysThisWeek = (habitId: string) =>
	[...currentWeekDays].filter((dayKey) => getMetric(activityByDay.get(dayKey) ?? {}, habitId).count > 0)
		.length;

const weeklyProgress = habits.map((habit) => {
	const completed = completedDaysThisWeek(habit.id);
	const goal = habit.weeklyGoal;
	return {
		habit,
		completed,
		goal,
		percent: Math.min(100, Math.round((completed / goal) * 100)),
		remaining: Math.max(0, goal - completed),
		minimum: habit.minimumMinutes,
	};
});

const timeSummary = habits.map((habit) => {
	const entries = enrichedCheckins.filter(({ habitId }) => habitId === habit.id);
	const timedEntries = entries.filter(({ durationMinutes }) => durationMinutes > 0);
	const weekMinutes = timedEntries
		.filter(({ dayKey }) => currentWeekDays.has(dayKey))
		.reduce((total, { durationMinutes }) => total + durationMinutes, 0);
	const monthMinutes = timedEntries
		.filter(({ dayKey }) => dayKey.startsWith(currentMonthKey))
		.reduce((total, { durationMinutes }) => total + durationMinutes, 0);
	const totalMinutes = timedEntries.reduce(
		(total, { durationMinutes }) => total + durationMinutes,
		0,
	);
	const monthGoalMinutes = habit.weeklyGoal * 4 * habit.minimumMinutes;
	return {
		habit,
		weekMinutes,
		monthMinutes,
		monthGoalMinutes,
		monthProgress: Math.min(100, Math.round((monthMinutes / monthGoalMinutes) * 100)),
		totalMinutes,
		timedSessions: timedEntries.length,
		averageMinutes: timedEntries.length > 0 ? Math.round(totalMinutes / timedEntries.length) : 0,
	};
});
const currentMonthTotalMinutes = timeSummary.reduce(
	(total, summary) => total + summary.monthMinutes,
	0,
);

const monthKeys = [
	...new Set([currentMonthKey, ...enrichedCheckins.map(({ dayKey }) => dayKey.slice(0, 7))]),
].sort((a, b) => b.localeCompare(a));
const monthCalendars = monthKeys.map((monthKey) => {
	const calendar = getMonthCalendar(monthKey);
	const entries = [...activityByDay.entries()].filter(([dayKey]) => dayKey.startsWith(monthKey));
	const activeDays = new Set(
		entries
			.filter(([, summary]) => habits.some(({ id }) => getMetric(summary, id).count > 0))
			.map(([dayKey]) => dayKey),
	).size;
	const lights = entries.reduce(
		(total, [, summary]) =>
			total + habits.reduce((count, { id }) => count + Number(getMetric(summary, id).count > 0), 0),
		0,
	);
	const minutes = entries.reduce(
		(total, [, summary]) =>
			total + habits.reduce((sum, { id }) => sum + getMetric(summary, id).minutes, 0),
		0,
	);
	const zhLabel = `${calendar.year} 年 ${calendar.month} 月`;
	const enLabel = new Intl.DateTimeFormat('en-US', {
		year: 'numeric',
		month: 'long',
		timeZone: 'UTC',
	}).format(new Date(Date.UTC(calendar.year, calendar.month - 1, 1)));

	return {
		...calendar,
		monthKey,
		zhLabel,
		enLabel,
		activeDays,
		lights,
		minutes,
		dayCells: calendar.days.map((dayKey) => {
			const summary = activityByDay.get(dayKey) ?? {};
			const entryCount = Object.values(summary).reduce((sum, metric) => sum + metric.count, 0);
			return {
				dayKey,
				dayNumber: Number(dayKey.slice(-2)),
				summary,
				entryCount,
			};
		}),
	};
});

const currentMonth = (
	monthCalendars.find(({ monthKey }) => monthKey === currentMonthKey)
	?? monthCalendars[0]
)!;
const todaySummary = activityByDay.get(todayKey) ?? {};
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});
const timeFormatter = new Intl.DateTimeFormat('zh-CN', {
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
});
const formatDate = (date: Date) => {
	const dateLabel = dateFormatter.format(date).replaceAll('/', ' / ');
	const hasTime = date.getHours() !== 0 || date.getMinutes() !== 0;
	return hasTime ? `${dateLabel} · ${timeFormatter.format(date)}` : dateLabel;
};
const dashboardState = JSON.stringify({
	habits: habits.map(({ id, name, color, weeklyGoal, minimumMinutes }) => ({
		id,
		name,
		color,
		weeklyGoal,
		minimumMinutes,
	})),
	activityByDay: Object.fromEntries(activityByDay),
	copy: {
		weekRemaining: copy.weekRemaining,
		weekComplete: copy.weekComplete,
		timeGoalLabel: copy.timeGoalLabel,
		recordsSummary: copy.recordsSummary,
		statsLamps: copy.statsLamps,
		statsDays: copy.statsDays,
		statsMinutes: copy.statsMinutes,
	},
}).replaceAll('<', '\\u003c');
---

<section
	class="daily-checkins container"
	aria-labelledby="daily-checkin-title"
	data-lamp-dashboard
	data-build-day={todayKey}
>
	<header class="checkin-heading">
		<div>
			<div class="eyebrow">{copy.pageKicker}</div>
			<h1
				class="section-title"
				id="daily-checkin-title"
				data-bilingual="text"
				data-zh={copy.pageTitle.zh}
				data-en={copy.pageTitle.en}
			>{copy.pageTitle.zh}</h1>
			<p
				class="checkin-intro"
				data-bilingual="text"
				data-zh={copy.pageIntro.zh}
				data-en={copy.pageIntro.en}
			>
				{copy.pageIntro.zh}
			</p>
		</div>
		<div class="today-state" aria-label="今日完成状态">
			<div class="today-date">
				<span data-bilingual="text" data-zh={copy.todayLabel.zh} data-en={copy.todayLabel.en}>
					{copy.todayLabel.zh}
				</span>
				<strong data-today-value>{todayKey.slice(5).replace('-', ' / ')}</strong>
			</div>
			<div class="today-lamps">
				{habits.map((habit) => (
					<span
						class:list={['mini-lamp', { 'is-lit': getMetric(todaySummary, habit.id).count > 0 }]}
						data-today-habit={habit.id}
						style={`--habit-color: ${habit.color}`}
						title={habit.name.zh}
					/>
				))}
			</div>
		</div>
	</header>

	<div class="quick-panel glass-card">
		<div class="quick-copy">
			<span class="quick-kicker">{copy.quickKicker}</span>
			<h2
				data-bilingual="text"
				data-zh={copy.quickTitle.zh}
				data-en={copy.quickTitle.en}
			>
				{copy.quickTitle.zh}
			</h2>
			<p
				data-bilingual="text"
				data-zh={copy.quickIntro.zh}
				data-en={copy.quickIntro.en}
			>
				{copy.quickIntro.zh}
			</p>
		</div>
		<div class="quick-actions">
			{habits.map((habit) => (
				<a
					class="quick-action"
					href={`/admin/?quick-checkin=${encodeURIComponent(habit.id)}`}
					data-quick-habit={habit.id}
					style={`--habit-color: ${habit.color}`}
				>
					<span class="action-lamp" aria-hidden="true" />
					<span>
						<strong data-bilingual="text" data-zh={habit.name.zh} data-en={habit.name.en}>
							{habit.name.zh}
						</strong>
						<small data-bilingual="text" data-zh={copy.quickAction.zh} data-en={copy.quickAction.en}>
							{copy.quickAction.zh}
						</small>
					</span>
				</a>
			))}
		</div>
	</div>

	<div class="weekly-grid">
		{
			weeklyProgress.map(({ habit, completed, goal, percent, remaining, minimum }) => {
				const remainingZh = remaining > 0
					? fillTemplate(copy.weekRemaining.zh, { count: remaining })
					: copy.weekComplete.zh;
				const remainingEn = remaining > 0
					? fillTemplate(copy.weekRemaining.en, { count: remaining })
					: copy.weekComplete.en;
				return (
				<article
					class="weekly-card glass-card"
					data-weekly-habit={habit.id}
					data-weekly-goal={goal}
					data-minimum-minutes={minimum}
					style={`--habit: ${habit.color}`}
				>
					<div class="weekly-card-top">
						<div>
							<span class="habit-label">{habit.code}</span>
							<h2
								data-bilingual="text"
								data-zh={habit.name.zh}
								data-en={habit.name.en}
							>
								{habit.name.zh}
							</h2>
						</div>
						<strong class="weekly-ratio"><b data-weekly-completed>{completed}</b><span> / {goal}</span></strong>
					</div>
					<div class="progress-track" aria-label={`${habit.name.zh}本周进度`}>
						<span data-weekly-progress style={`--progress: ${percent}%`} />
					</div>
					<div class="weekly-note">
						<span
							data-weekly-note
							data-bilingual="text"
							data-zh={remainingZh}
							data-en={remainingEn}
						>
							{remainingZh}
						</span>
						<small
							data-bilingual="text"
							data-zh={fillTemplate(copy.minimumLabel.zh, { minutes: minimum })}
							data-en={fillTemplate(copy.minimumLabel.en, { minutes: minimum })}
						>
							{fillTemplate(copy.minimumLabel.zh, { minutes: minimum })}
						</small>
					</div>
				</article>
				);
			})
		}
	</div>

	<section class="time-ledger glass-card" aria-labelledby="time-ledger-title">
		<div class="time-ledger-heading">
			<div>
				<span class="time-kicker">{copy.timeKicker}</span>
				<h2
					id="time-ledger-title"
					data-bilingual="text"
					data-zh={copy.timeTitle.zh}
					data-en={copy.timeTitle.en}
				>
					{copy.timeTitle.zh}
				</h2>
				<p
					data-bilingual="text"
					data-zh={copy.timeIntro.zh}
					data-en={copy.timeIntro.en}
				>
					{copy.timeIntro.zh}
				</p>
			</div>
			<div class="month-time-total">
				<span
					data-bilingual="text"
					data-zh={copy.timeMonthTotal.zh}
					data-en={copy.timeMonthTotal.en}
				>
					{copy.timeMonthTotal.zh}
				</span>
				<strong data-current-month-total>{currentMonthTotalMinutes}</strong>
				<small data-bilingual="text" data-zh={copy.timeUnit.zh} data-en={copy.timeUnit.en}>
					{copy.timeUnit.zh}
				</small>
			</div>
		</div>
		<div class="time-ledger-grid">
			{timeSummary.map(({ habit, weekMinutes, monthMinutes, monthGoalMinutes, monthProgress, totalMinutes, timedSessions, averageMinutes }) => (
				<article
					class="time-card"
					data-time-habit={habit.id}
					data-month-goal={monthGoalMinutes}
					style={`--habit-color: ${habit.color}`}
				>
					<div class="time-card-head">
						<span class="time-card-code">{habit.code}</span>
						<h3 data-bilingual="text" data-zh={habit.name.zh} data-en={habit.name.en}>
							{habit.name.zh}
						</h3>
					</div>
					<div class="time-card-primary">
						<span data-bilingual="text" data-zh={copy.timeMonthLabel.zh} data-en={copy.timeMonthLabel.en}>
							{copy.timeMonthLabel.zh}
						</span>
						<strong data-time-month>{monthMinutes}</strong>
						<small data-bilingual="text" data-zh={copy.timeUnit.zh} data-en={copy.timeUnit.en}>
							{copy.timeUnit.zh}
						</small>
					</div>
					<div class="time-goal-row">
						<span
							data-time-goal-label
							data-bilingual="text"
							data-zh={fillTemplate(copy.timeGoalLabel.zh, { minutes: monthGoalMinutes })}
							data-en={fillTemplate(copy.timeGoalLabel.en, { minutes: monthGoalMinutes })}
						>
							{fillTemplate(copy.timeGoalLabel.zh, { minutes: monthGoalMinutes })}
						</span>
						<strong data-time-goal-percent>{monthProgress}%</strong>
					</div>
					<div class="time-share-track" aria-hidden="true">
						<span data-time-share style={`--time-share: ${monthProgress}%`} />
					</div>
					<dl class="time-card-metrics">
						<div>
							<dt data-bilingual="text" data-zh={copy.timeWeekLabel.zh} data-en={copy.timeWeekLabel.en}>
								{copy.timeWeekLabel.zh}
							</dt>
							<dd><span data-time-week>{weekMinutes}</span><small data-bilingual="text" data-zh={copy.timeUnit.zh} data-en={copy.timeUnit.en}>{copy.timeUnit.zh}</small></dd>
						</div>
						<div>
							<dt data-bilingual="text" data-zh={copy.timeTotalLabel.zh} data-en={copy.timeTotalLabel.en}>
								{copy.timeTotalLabel.zh}
							</dt>
							<dd>{totalMinutes}<small data-bilingual="text" data-zh={copy.timeUnit.zh} data-en={copy.timeUnit.en}>{copy.timeUnit.zh}</small></dd>
						</div>
					</dl>
					<div class="time-card-foot">
						{timedSessions > 0 ? (
							<>
								<span
									data-bilingual="text"
									data-zh={fillTemplate(copy.timeSessionsLabel.zh, { count: timedSessions })}
									data-en={fillTemplate(copy.timeSessionsLabel.en, { count: timedSessions })}
								>
									{fillTemplate(copy.timeSessionsLabel.zh, { count: timedSessions })}
								</span>
								<span
									data-bilingual="text"
									data-zh={fillTemplate(copy.timeAverageLabel.zh, { minutes: averageMinutes })}
									data-en={fillTemplate(copy.timeAverageLabel.en, { minutes: averageMinutes })}
								>
									{fillTemplate(copy.timeAverageLabel.zh, { minutes: averageMinutes })}
								</span>
							</>
						) : (
							<span data-bilingual="text" data-zh={copy.timeEmptyLabel.zh} data-en={copy.timeEmptyLabel.en}>
								{copy.timeEmptyLabel.zh}
							</span>
						)}
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="calendar-card glass-card" aria-labelledby="lamp-calendar-title">
		<div class="calendar-heading">
			<div>
				<span class="calendar-kicker">{copy.calendarKicker}</span>
				<h2
					id="lamp-calendar-title"
					data-bilingual="text"
					data-zh={copy.calendarTitle.zh}
					data-en={copy.calendarTitle.en}
				>
					{copy.calendarTitle.zh}
				</h2>
			</div>
			<div class="lamp-legend" aria-label="图例">
				{habits.map((habit) => (
					<span data-legend-habit={habit.id} style={`--habit-color: ${habit.color}`}>
						<i class="legend-lamp" />
						<b data-bilingual="text" data-zh={habit.name.zh} data-en={habit.name.en}>
							{habit.name.zh}
						</b>
					</span>
				))}
			</div>
		</div>

		<div class="month-switcher" role="tablist" aria-label="选择月份">
			{
				monthCalendars.map(({ monthKey, zhLabel, enLabel }, index) => (
					<button
						type="button"
						role="tab"
						class:list={{ 'is-active': index === 0 }}
						aria-selected={index === 0 ? 'true' : 'false'}
						data-month-target={monthKey}
						data-bilingual="text"
						data-zh={zhLabel}
						data-en={enLabel}
					>
						{zhLabel}
					</button>
				))
			}
		</div>

		{
			monthCalendars.map((calendar, index) => (
				<div class="month-panel" data-month-panel={calendar.monthKey} hidden={index !== 0}>
					<div class="calendar-weekdays" aria-hidden="true">
						{[
							['一', 'Mon'],
							['二', 'Tue'],
							['三', 'Wed'],
							['四', 'Thu'],
							['五', 'Fri'],
							['六', 'Sat'],
							['日', 'Sun'],
						].map(([zh, en]) => (
							<span data-bilingual="text" data-zh={zh} data-en={en}>{zh}</span>
						))}
					</div>
					<div class="calendar-grid">
						{Array.from({ length: calendar.leadingEmptyDays }, () => <span class="calendar-empty" />)}
						{calendar.dayCells.map(({ dayKey, dayNumber, summary, entryCount }) => (
							<button
								type="button"
								class:list={[
									'calendar-day',
									{
										'is-today': dayKey === todayKey,
										'has-entry': entryCount > 0,
									},
								]}
								data-day-key={dayKey}
								data-entry-target={entryCount > 0 ? dayKey : undefined}
								aria-label={`${dayKey}，${habits.map((habit) => `${habit.name.zh}${getMetric(summary, habit.id).count > 0 ? '已完成' : '未完成'}`).join('，')}`}
							>
								<span class="day-number">{dayNumber}</span>
								<span class="day-lamps" aria-hidden="true">
									{habits.map((habit) => (
										<i
											class:list={['calendar-lamp', { 'is-lit': getMetric(summary, habit.id).count > 0 }]}
											style={`--habit-color: ${habit.color}`}
										/>
									))}
								</span>
								{entryCount > 0 && <small>{entryCount}</small>}
							</button>
						))}
					</div>
					<div class="month-stats">
						<div>
							<strong data-month-lights>{calendar.lights}</strong>
							<span data-bilingual="text" data-zh={copy.statsLamps.zh} data-en={copy.statsLamps.en}>
								{copy.statsLamps.zh}
							</span>
						</div>
						<div>
							<strong data-month-days>{calendar.activeDays}</strong>
							<span data-bilingual="text" data-zh={copy.statsDays.zh} data-en={copy.statsDays.en}>
								{copy.statsDays.zh}
							</span>
						</div>
						<div>
							<strong data-month-minutes>{calendar.minutes}</strong>
							<span data-bilingual="text" data-zh={copy.statsMinutes.zh} data-en={copy.statsMinutes.en}>
								{copy.statsMinutes.zh}
							</span>
						</div>
					</div>
				</div>
			))
		}
	</section>

	<div class="records-heading">
		<div>
			<span class="records-kicker">{copy.recordsKicker}</span>
			<h2 data-bilingual="text" data-zh={copy.recordsTitle.zh} data-en={copy.recordsTitle.en}>
				{copy.recordsTitle.zh}
			</h2>
		</div>
		<p
			data-records-summary
			data-bilingual="text"
			data-zh={fillTemplate(copy.recordsSummary.zh, { days: currentMonth.activeDays, lights: currentMonth.lights })}
			data-en={fillTemplate(copy.recordsSummary.en, { days: currentMonth.activeDays, lights: currentMonth.lights })}
		>
			{fillTemplate(copy.recordsSummary.zh, { days: currentMonth.activeDays, lights: currentMonth.lights })}
		</p>
	</div>

	<div class="checkin-board glass-card">
		<div class="board-topline">
			<span class="board-mark" aria-hidden="true">✓</span>
			<span data-bilingual="text" data-zh={copy.listTitle.zh} data-en={copy.listTitle.en}>
				{copy.listTitle.zh}
			</span>
			<span class="board-count">{String(checkins.length).padStart(2, '0')}</span>
		</div>
		<div class="checkin-list">
			{
				enrichedCheckins.map(({ checkin, dayKey, habitId }) => {
					const habit = getHabit(habitId);
					return (
					<article
						class="checkin-entry"
						id={firstCheckinIdByDay.get(dayKey) === checkin.id
							? `checkin-day-${dayKey}`
							: `checkin-${checkin.id.replaceAll('/', '-')}`}
					>
						<time datetime={checkin.data.date.toISOString()}>{formatDate(checkin.data.date)}</time>
						<div class="checkin-content">
							<div class="entry-heading">
								<h3>{checkin.data.title}</h3>
								<span
									class="category-badge"
									style={`--habit-color: ${habit.color}`}
									data-bilingual="text"
									data-zh={habit.name.zh}
									data-en={habit.name.en}
								>
									{habit.name.zh}
								</span>
							</div>
							{checkin.data.summary && <p class="checkin-summary">{checkin.data.summary}</p>}
							{checkin.data.duration > 0 && (
								<dl class="checkin-details quick-record-details">
									<div>
										<dt data-bilingual="text" data-zh="记录项目" data-en="Activity">记录项目</dt>
										<dd>{checkin.data.activity || habit.name.zh}</dd>
									</div>
									<div>
										<dt data-bilingual="text" data-zh="完成时长" data-en="Duration">完成时长</dt>
										<dd>{checkin.data.duration} 分钟</dd>
									</div>
								</dl>
							)}
							{renderedBodies.get(checkin.id) && (
								<div class="checkin-body prose prose-compact" set:html={renderedBodies.get(checkin.id)} />
							)}
							{checkin.data.items.length > 0 && (
								<dl class="checkin-details">
									{checkin.data.items.map((item) => (
										<div>
											<dt>{item.label}</dt>
											<dd>
												{item.href ? (
													<a href={item.href} target="_blank" rel="noreferrer">
														{item.value}<span aria-hidden="true"> ↗</span>
													</a>
												) : (
													item.value
												)}
											</dd>
										</div>
									))}
								</dl>
							)}
							<div class="checkin-tags">
								{checkin.data.tags.map((tag) => <span>#{getTagLabel(tag, tagMap)}</span>)}
							</div>
						</div>
					</article>
					);
				})
			}
		</div>
	</div>
	<script is:inline type="application/json" data-dashboard-state set:html={dashboardState} />
</section>

<script>
	interface RuntimeHabit {
		id: string;
		name: { zh: string; en: string };
		color: string;
		weeklyGoal: number;
		minimumMinutes: number;
	}

	interface RuntimeMetric {
		count: number;
		minutes: number;
	}

	interface DashboardState {
		habits: RuntimeHabit[];
		activityByDay: Record<string, Record<string, RuntimeMetric>>;
		copy: {
			weekRemaining: { zh: string; en: string };
			weekComplete: { zh: string; en: string };
			timeGoalLabel: { zh: string; en: string };
			recordsSummary: { zh: string; en: string };
			statsLamps: { zh: string; en: string };
			statsDays: { zh: string; en: string };
			statsMinutes: { zh: string; en: string };
		};
	}

	const getShanghaiDayKey = () => {
		const parts = new Intl.DateTimeFormat('en-CA', {
			timeZone: 'Asia/Shanghai',
			year: 'numeric',
			month: '2-digit',
			day: '2-digit',
		}).formatToParts(new Date());
		const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
		return `${values.year}-${values.month}-${values.day}`;
	};

	const addRuntimeDays = (dayKey: string, amount: number) => {
		const [year, month, day] = dayKey.split('-').map(Number);
		const date = new Date(Date.UTC(year, month - 1, day + amount));
		return [
			date.getUTCFullYear(),
			String(date.getUTCMonth() + 1).padStart(2, '0'),
			String(date.getUTCDate()).padStart(2, '0'),
		].join('-');
	};

	const getRuntimeWeekDays = (dayKey: string) => {
		const [year, month, day] = dayKey.split('-').map(Number);
		const date = new Date(Date.UTC(year, month - 1, day));
		const mondayOffset = (date.getUTCDay() + 6) % 7;
		const weekStart = addRuntimeDays(dayKey, -mondayOffset);
		return Array.from({ length: 7 }, (_, index) => addRuntimeDays(weekStart, index));
	};

	const fillRuntimeTemplate = (template: string, values: Record<string, number>) =>
		Object.entries(values).reduce(
			(result, [key, value]) => result.replaceAll(`{${key}}`, String(value)),
			template,
		);

	const setRuntimeBilingualText = (
		element: HTMLElement | null,
		copy: { zh: string; en: string },
	) => {
		if (!element) return;
		element.dataset.bilingual = 'text';
		element.dataset.zh = copy.zh;
		element.dataset.en = copy.en;
		element.textContent = document.documentElement.dataset.language === 'en' ? copy.en : copy.zh;
	};

	const getRuntimeMetric = (state: DashboardState, dayKey: string, habitId: string) =>
		state.activityByDay[dayKey]?.[habitId] ?? { count: 0, minutes: 0 };

	const getRuntimeMonthStats = (state: DashboardState, monthKey: string) => {
		const entries = Object.entries(state.activityByDay).filter(([dayKey]) =>
			dayKey.startsWith(monthKey),
		);
		return {
			activeDays: entries.filter(([, summary]) =>
				state.habits.some(({ id }) => Number(summary[id]?.count ?? 0) > 0),
			).length,
			lights: entries.reduce(
				(total, [, summary]) =>
					total
					+ state.habits.reduce(
						(count, { id }) => count + Number(Number(summary[id]?.count ?? 0) > 0),
						0,
					),
				0,
			),
			minutes: entries.reduce(
				(total, [, summary]) =>
					total
					+ state.habits.reduce(
						(sum, { id }) => sum + Number(summary[id]?.minutes ?? 0),
						0,
					),
				0,
			),
		};
	};

	const getRuntimeMonth = (monthKey: string) => {
		const [year, month] = monthKey.split('-').map(Number);
		const totalDays = new Date(Date.UTC(year, month, 0)).getUTCDate();
		const leadingEmptyDays = (new Date(Date.UTC(year, month - 1, 1)).getUTCDay() + 6) % 7;
		return {
			year,
			month,
			leadingEmptyDays,
			days: Array.from(
				{ length: totalDays },
				(_, index) => `${monthKey}-${String(index + 1).padStart(2, '0')}`,
			),
		};
	};

	const createRuntimeMonth = (
		root: HTMLElement,
		state: DashboardState,
		monthKey: string,
		todayKey: string,
	) => {
		const switcher = root.querySelector<HTMLElement>('.month-switcher');
		const firstPanel = root.querySelector<HTMLElement>('[data-month-panel]');
		if (!switcher || !firstPanel?.parentElement) return;

		const calendar = getRuntimeMonth(monthKey);
		const zhLabel = `${calendar.year} 年 ${calendar.month} 月`;
		const enLabel = new Intl.DateTimeFormat('en-US', {
			year: 'numeric',
			month: 'long',
			timeZone: 'UTC',
		}).format(new Date(Date.UTC(calendar.year, calendar.month - 1, 1)));

		const tab = document.createElement('button');
		tab.type = 'button';
		tab.setAttribute('role', 'tab');
		tab.dataset.monthTarget = monthKey;
		tab.setAttribute('aria-selected', 'false');
		setRuntimeBilingualText(tab, { zh: zhLabel, en: enLabel });
		switcher.prepend(tab);

		const panel = document.createElement('div');
		panel.className = 'month-panel';
		panel.dataset.monthPanel = monthKey;
		panel.hidden = true;

		const weekdays = document.createElement('div');
		weekdays.className = 'calendar-weekdays';
		weekdays.setAttribute('aria-hidden', 'true');
		[
			['一', 'Mon'],
			['二', 'Tue'],
			['三', 'Wed'],
			['四', 'Thu'],
			['五', 'Fri'],
			['六', 'Sat'],
			['日', 'Sun'],
		].forEach(([zh, en]) => {
			const label = document.createElement('span');
			setRuntimeBilingualText(label, { zh, en });
			weekdays.append(label);
		});
		panel.append(weekdays);

		const grid = document.createElement('div');
		grid.className = 'calendar-grid';
		Array.from({ length: calendar.leadingEmptyDays }).forEach(() => {
			const empty = document.createElement('span');
			empty.className = 'calendar-empty';
			grid.append(empty);
		});

		calendar.days.forEach((dayKey, index) => {
			const summary = state.activityByDay[dayKey] ?? {};
			const entryCount = Object.values(summary).reduce(
				(total, metric) => total + Number(metric.count ?? 0),
				0,
			);
			const day = document.createElement('button');
			day.type = 'button';
			day.className = 'calendar-day';
			day.classList.toggle('is-today', dayKey === todayKey);
			day.classList.toggle('has-entry', entryCount > 0);
			day.dataset.dayKey = dayKey;
			if (entryCount > 0) day.dataset.entryTarget = dayKey;
			day.setAttribute(
				'aria-label',
				`${dayKey}，${state.habits.map((habit) => `${habit.name.zh}${getRuntimeMetric(state, dayKey, habit.id).count > 0 ? '已完成' : '未完成'}`).join('，')}`,
			);

			const number = document.createElement('span');
			number.className = 'day-number';
			number.textContent = String(index + 1);
			day.append(number);

			const lamps = document.createElement('span');
			lamps.className = 'day-lamps';
			lamps.setAttribute('aria-hidden', 'true');
			state.habits.forEach((habit) => {
				const lamp = document.createElement('i');
				lamp.className = 'calendar-lamp';
				lamp.classList.toggle('is-lit', getRuntimeMetric(state, dayKey, habit.id).count > 0);
				lamp.style.setProperty('--habit-color', habit.color);
				lamps.append(lamp);
			});
			day.append(lamps);

			if (entryCount > 0) {
				const count = document.createElement('small');
				count.textContent = String(entryCount);
				day.append(count);
			}
			grid.append(day);
		});
		panel.append(grid);

		const stats = getRuntimeMonthStats(state, monthKey);
		const statsRow = document.createElement('div');
		statsRow.className = 'month-stats';
		[
			['monthLights', stats.lights, state.copy.statsLamps],
			['monthDays', stats.activeDays, state.copy.statsDays],
			['monthMinutes', stats.minutes, state.copy.statsMinutes],
		].forEach(([dataKey, value, label]) => {
			const item = document.createElement('div');
			const strong = document.createElement('strong');
			strong.dataset[String(dataKey)] = '';
			strong.textContent = String(value);
			const span = document.createElement('span');
			setRuntimeBilingualText(span, label as { zh: string; en: string });
			item.append(strong, span);
			statsRow.append(item);
		});
		panel.append(statsRow);
		firstPanel.parentElement.insertBefore(panel, firstPanel);
	};

	const syncRuntimePeriod = (root: HTMLElement, state: DashboardState) => {
		const todayKey = getShanghaiDayKey();
		const monthKey = todayKey.slice(0, 7);
		const weekDays = getRuntimeWeekDays(todayKey);
		root.dataset.runtimeDay = todayKey;

		const todayValue = root.querySelector<HTMLElement>('[data-today-value]');
		if (todayValue) todayValue.textContent = todayKey.slice(5).replace('-', ' / ');
		root.querySelectorAll<HTMLElement>('[data-today-habit]').forEach((lamp) => {
			lamp.classList.toggle(
				'is-lit',
				getRuntimeMetric(state, todayKey, lamp.dataset.todayHabit ?? '').count > 0,
			);
		});

		if (![...root.querySelectorAll<HTMLElement>('[data-month-panel]')].some(
			(panel) => panel.dataset.monthPanel === monthKey,
		)) {
			createRuntimeMonth(root, state, monthKey, todayKey);
		}

		root.querySelectorAll<HTMLElement>('[data-day-key]').forEach((day) => {
			day.classList.toggle('is-today', day.dataset.dayKey === todayKey);
		});

		state.habits.forEach((habit) => {
			const completed = weekDays.filter(
				(dayKey) => getRuntimeMetric(state, dayKey, habit.id).count > 0,
			).length;
			const card = [...root.querySelectorAll<HTMLElement>('[data-weekly-habit]')]
				.find((item) => item.dataset.weeklyHabit === habit.id);
			if (card) {
				const completedLabel = card.querySelector<HTMLElement>('[data-weekly-completed]');
				if (completedLabel) completedLabel.textContent = String(completed);
				card.querySelector<HTMLElement>('[data-weekly-progress]')?.style.setProperty(
					'--progress',
					`${Math.min(100, Math.round((completed / habit.weeklyGoal) * 100))}%`,
				);
				const remaining = Math.max(0, habit.weeklyGoal - completed);
				setRuntimeBilingualText(
					card.querySelector<HTMLElement>('[data-weekly-note]'),
					remaining > 0
						? {
								zh: fillRuntimeTemplate(state.copy.weekRemaining.zh, { count: remaining }),
								en: fillRuntimeTemplate(state.copy.weekRemaining.en, { count: remaining }),
							}
						: state.copy.weekComplete,
				);
			}
		});

		const monthMinutes = new Map<string, number>();
		state.habits.forEach((habit) => {
			const weekTotal = weekDays.reduce(
				(total, dayKey) => total + getRuntimeMetric(state, dayKey, habit.id).minutes,
				0,
			);
			const monthTotal = Object.entries(state.activityByDay)
				.filter(([dayKey]) => dayKey.startsWith(monthKey))
				.reduce(
					(total, [dayKey]) => total + getRuntimeMetric(state, dayKey, habit.id).minutes,
					0,
				);
			monthMinutes.set(habit.id, monthTotal);
			const card = [...root.querySelectorAll<HTMLElement>('[data-time-habit]')]
				.find((item) => item.dataset.timeHabit === habit.id);
			if (card) {
				const monthValue = card.querySelector<HTMLElement>('[data-time-month]');
				const weekValue = card.querySelector<HTMLElement>('[data-time-week]');
				if (monthValue) monthValue.textContent = String(monthTotal);
				if (weekValue) weekValue.textContent = String(weekTotal);
				const monthGoal = habit.weeklyGoal * 4 * habit.minimumMinutes;
				const monthProgress = Math.min(
					100,
					Math.round((monthTotal / monthGoal) * 100),
				);
				setRuntimeBilingualText(
					card.querySelector<HTMLElement>('[data-time-goal-label]'),
					{
						zh: fillRuntimeTemplate(state.copy.timeGoalLabel.zh, {
							minutes: monthGoal,
						}),
						en: fillRuntimeTemplate(state.copy.timeGoalLabel.en, {
							minutes: monthGoal,
						}),
					},
				);
				const progressValue = card.querySelector<HTMLElement>('[data-time-goal-percent]');
				if (progressValue) progressValue.textContent = `${monthProgress}%`;
				card.querySelector<HTMLElement>('[data-time-share]')?.style.setProperty(
					'--time-share',
					`${monthProgress}%`,
				);
			}
		});

		const currentMonthTotal = [...monthMinutes.values()].reduce((total, value) => total + value, 0);
		const currentMonthValue = root.querySelector<HTMLElement>('[data-current-month-total]');
		if (currentMonthValue) currentMonthValue.textContent = String(currentMonthTotal);
		const stats = getRuntimeMonthStats(state, monthKey);
		setRuntimeBilingualText(root.querySelector<HTMLElement>('[data-records-summary]'), {
			zh: fillRuntimeTemplate(state.copy.recordsSummary.zh, {
				days: stats.activeDays,
				lights: stats.lights,
			}),
			en: fillRuntimeTemplate(state.copy.recordsSummary.en, {
				days: stats.activeDays,
				lights: stats.lights,
			}),
		});

		root.querySelectorAll<HTMLButtonElement>('[data-month-target]').forEach((tab) => {
			const active = tab.dataset.monthTarget === monthKey;
			tab.classList.toggle('is-active', active);
			tab.setAttribute('aria-selected', String(active));
		});
		root.querySelectorAll<HTMLElement>('[data-month-panel]').forEach((panel) => {
			panel.hidden = panel.dataset.monthPanel !== monthKey;
		});
	};

	const setupLampDashboard = () => {
		document
			.querySelectorAll<HTMLElement>('[data-lamp-dashboard]:not([data-ready])')
			.forEach((root) => {
				root.dataset.ready = 'true';
				const stateElement = root.querySelector<HTMLScriptElement>('[data-dashboard-state]');
				if (!stateElement?.textContent) return;
				const state = JSON.parse(stateElement.textContent) as DashboardState;
				syncRuntimePeriod(root, state);

				root.addEventListener('click', (event) => {
					const target = event.target;
					if (!(target instanceof Element)) return;
					const tab = target.closest<HTMLButtonElement>('[data-month-target]');
					if (tab && root.contains(tab)) {
						const monthTarget = tab.dataset.monthTarget;
						root.querySelectorAll<HTMLButtonElement>('[data-month-target]').forEach((candidate) => {
							const active = candidate === tab;
							candidate.classList.toggle('is-active', active);
							candidate.setAttribute('aria-selected', String(active));
						});
						root.querySelectorAll<HTMLElement>('[data-month-panel]').forEach((panel) => {
							panel.hidden = panel.dataset.monthPanel !== monthTarget;
						});
						return;
					}

					const day = target.closest<HTMLButtonElement>('[data-entry-target]');
					if (!day || !root.contains(day)) return;
					const entry = document.getElementById(`checkin-day-${day.dataset.entryTarget}`);
					entry?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				});

				const dayTimer = window.setInterval(() => {
					if (!root.isConnected) {
						window.clearInterval(dayTimer);
						return;
					}
					if (root.dataset.runtimeDay !== getShanghaiDayKey()) syncRuntimePeriod(root, state);
				}, 60_000);
			});
	};

	setupLampDashboard();
	document.addEventListener('astro:page-load', setupLampDashboard);
</script>

<style>
	.daily-checkins {
		padding: 3.4rem 0 3rem;
		animation: checkin-rise 720ms 180ms both;
	}

	.checkin-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 1.3rem;
	}

	.checkin-heading .section-title {
		margin-top: 0.45rem;
	}

	.checkin-intro {
		max-width: 37rem;
		margin: 0.8rem 0 0;
		color: var(--text-soft);
	}

	.today-state {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.8rem 1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-panel) 88%, transparent);
	}

	.today-date {
		display: grid;
		font-size: 0.72rem;
		color: var(--text-soft);
	}

	.today-date strong {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 0.95rem;
	}

	.today-lamps {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.mini-lamp,
	.calendar-lamp,
