---
import type { CollectionEntry } from 'astro:content';
import { getTagLabel, getTagMap } from '../lib/content';
import {
	addDays,
	formatShanghaiDayKey,
	getCheckinCategory,
	getCheckinDayKey,
	getMonthCalendar,
	getWeekStart,
	type HabitCategory,
} from '../lib/checkin-metrics';
import { renderMarkdownContent } from '../lib/markdown';
import { siteConfig } from '../data/site';

interface Props {
	checkins: CollectionEntry<'checkins'>[];
}

interface HabitDaySummary {
	english: { count: number; minutes: number };
	exercise: { count: number; minutes: number };
	other: { count: number; minutes: number };
}

const { checkins } = Astro.props;
const tagMap = await getTagMap();
const renderedBodies = new Map(
	await Promise.all(
		checkins.map(async (checkin) => [
			checkin.id,
			(await renderMarkdownContent(checkin.body ?? '', checkin.data)).code.trim(),
		] as const),
	),
);

const todayKey = formatShanghaiDayKey();
const currentMonthKey = todayKey.slice(0, 7);
const weekStart = getWeekStart(todayKey);
const currentWeekDays = new Set(Array.from({ length: 7 }, (_, index) => addDays(weekStart, index)));
const configuredGoals = siteConfig.checkinSettings?.weeklyGoals;
const configuredMinimums = siteConfig.checkinSettings?.minimumMinutes;
const weeklyGoals = {
	english: Math.min(7, Math.max(1, Number(configuredGoals?.english ?? 5))),
	exercise: Math.min(7, Math.max(1, Number(configuredGoals?.exercise ?? 3))),
};
const minimumMinutes = {
	english: Math.max(1, Number(configuredMinimums?.english ?? 5)),
	exercise: Math.max(1, Number(configuredMinimums?.exercise ?? 10)),
};

const emptyDaySummary = (): HabitDaySummary => ({
	english: { count: 0, minutes: 0 },
	exercise: { count: 0, minutes: 0 },
	other: { count: 0, minutes: 0 },
});

const enrichedCheckins = checkins.map((checkin) => ({
	checkin,
	dayKey: getCheckinDayKey(checkin),
	category: getCheckinCategory(checkin),
}));
const firstCheckinIdByDay = new Map<string, string>();
for (const { checkin, dayKey } of enrichedCheckins) {
	if (!firstCheckinIdByDay.has(dayKey)) firstCheckinIdByDay.set(dayKey, checkin.id);
}
const activityByDay = new Map<string, HabitDaySummary>();

for (const { checkin, dayKey, category } of enrichedCheckins) {
	const summary = activityByDay.get(dayKey) ?? emptyDaySummary();
	summary[category].count += 1;
	summary[category].minutes += Math.max(0, Number(checkin.data.duration ?? 0));
	activityByDay.set(dayKey, summary);
}

const completedDaysThisWeek = (category: 'english' | 'exercise') =>
	[...currentWeekDays].filter((dayKey) => (activityByDay.get(dayKey)?.[category].count ?? 0) > 0)
		.length;

const weeklyProgress = (['english', 'exercise'] as const).map((category) => {
	const completed = completedDaysThisWeek(category);
	const goal = weeklyGoals[category];
	return {
		category,
		completed,
		goal,
		percent: Math.min(100, Math.round((completed / goal) * 100)),
		remaining: Math.max(0, goal - completed),
		minimum: minimumMinutes[category],
	};
});

const monthKeys = [
	...new Set([currentMonthKey, ...enrichedCheckins.map(({ dayKey }) => dayKey.slice(0, 7))]),
].sort((a, b) => b.localeCompare(a));
const monthCalendars = monthKeys.map((monthKey) => {
	const calendar = getMonthCalendar(monthKey);
	const entries = [...activityByDay.entries()].filter(([dayKey]) => dayKey.startsWith(monthKey));
	const activeDays = new Set(
		entries
			.filter(([, summary]) => summary.english.count > 0 || summary.exercise.count > 0)
			.map(([dayKey]) => dayKey),
	).size;
	const lights = entries.reduce(
		(total, [, summary]) =>
			total + Number(summary.english.count > 0) + Number(summary.exercise.count > 0),
		0,
	);
	const minutes = entries.reduce(
		(total, [, summary]) => total + summary.english.minutes + summary.exercise.minutes,
		0,
	);
	const zhLabel = `${calendar.year} 年 ${calendar.month} 月`;
	const enLabel = new Intl.DateTimeFormat('en-US', {
		year: 'numeric',
		month: 'long',
		timeZone: 'UTC',
	}).format(new Date(Date.UTC(calendar.year, calendar.month - 1, 1)));

	return {
		...calendar,
		monthKey,
		zhLabel,
		enLabel,
		activeDays,
		lights,
		minutes,
		dayCells: calendar.days.map((dayKey) => {
			const summary = activityByDay.get(dayKey) ?? emptyDaySummary();
			const entryCount = summary.english.count + summary.exercise.count + summary.other.count;
			return {
				dayKey,
				dayNumber: Number(dayKey.slice(-2)),
				summary,
				entryCount,
			};
		}),
	};
});

const currentMonth = (
	monthCalendars.find(({ monthKey }) => monthKey === currentMonthKey)
	?? monthCalendars[0]
)!;
const todaySummary = activityByDay.get(todayKey) ?? emptyDaySummary();
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});
const timeFormatter = new Intl.DateTimeFormat('zh-CN', {
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
});
const formatDate = (date: Date) => {
	const dateLabel = dateFormatter.format(date).replaceAll('/', ' / ');
	const hasTime = date.getHours() !== 0 || date.getMinutes() !== 0;
	return hasTime ? `${dateLabel} · ${timeFormatter.format(date)}` : dateLabel;
};
const categoryCopy: Record<HabitCategory, { zh: string; en: string }> = {
	english: { zh: '英语学习', en: 'English' },
	exercise: { zh: '运动锻炼', en: 'Exercise' },
	other: { zh: '其他记录', en: 'Other' },
};
---

<section class="daily-checkins container" aria-labelledby="daily-checkin-title" data-lamp-dashboard>
	<header class="checkin-heading">
		<div>
			<div class="eyebrow" data-copy="checkins.kicker">LIGHT THE DAY</div>
			<h1 class="section-title" id="daily-checkin-title" data-copy="checkins.title">灯火计划</h1>
			<p class="checkin-intro" data-copy="checkins.intro">
				不追求完美连续，只把今天真正做过的事点亮。
			</p>
		</div>
		<div class="today-state" aria-label="今日完成状态">
			<div class="today-date">
				<span data-bilingual="text" data-zh="今天" data-en="Today">今天</span>
				<strong>{todayKey.slice(5).replace('-', ' / ')}</strong>
			</div>
			<div class="today-lamps">
				<span
					class:list={['mini-lamp', 'is-english', { 'is-lit': todaySummary.english.count > 0 }]}
					title="英语学习"
				/>
				<span
					class:list={['mini-lamp', 'is-exercise', { 'is-lit': todaySummary.exercise.count > 0 }]}
					title="运动锻炼"
				/>
			</div>
		</div>
	</header>

	<div class="quick-panel glass-card">
		<div class="quick-copy">
			<span class="quick-kicker">20 SECOND CHECK-IN</span>
			<h2 data-bilingual="text" data-zh="今天，想点亮哪一盏灯？" data-en="Which lamp will you light today?">
				今天，想点亮哪一盏灯？
			</h2>
			<p
				data-bilingual="text"
				data-zh={`英语 ${minimumMinutes.english} 分钟、运动 ${minimumMinutes.exercise} 分钟，也算认真开始。`}
				data-en={`Even ${minimumMinutes.english} minutes of English or ${minimumMinutes.exercise} minutes of movement counts.`}
			>
				英语 {minimumMinutes.english} 分钟、运动 {minimumMinutes.exercise} 分钟，也算认真开始。
			</p>
		</div>
		<div class="quick-actions">
			<a class="quick-action is-english" href="/admin/?quick-checkin=english">
				<span class="action-lamp" aria-hidden="true" />
				<span>
					<strong data-bilingual="text" data-zh="英语学习" data-en="English">英语学习</strong>
					<small data-bilingual="text" data-zh="快速记录 →" data-en="Quick check-in →">快速记录 →</small>
				</span>
			</a>
			<a class="quick-action is-exercise" href="/admin/?quick-checkin=exercise">
				<span class="action-lamp" aria-hidden="true" />
				<span>
					<strong data-bilingual="text" data-zh="运动锻炼" data-en="Exercise">运动锻炼</strong>
					<small data-bilingual="text" data-zh="快速记录 →" data-en="Quick check-in →">快速记录 →</small>
				</span>
			</a>
		</div>
	</div>

	<div class="weekly-grid">
		{
			weeklyProgress.map(({ category, completed, goal, percent, remaining, minimum }) => (
				<article class:list={['weekly-card', `is-${category}`, 'glass-card']}>
					<div class="weekly-card-top">
						<div>
							<span class="habit-label">
								{category === 'english' ? 'ENGLISH' : 'MOVEMENT'}
							</span>
							<h2
								data-bilingual="text"
								data-zh={categoryCopy[category].zh}
								data-en={categoryCopy[category].en}
							>
								{categoryCopy[category].zh}
							</h2>
						</div>
						<strong class="weekly-ratio">{completed}<span> / {goal}</span></strong>
					</div>
					<div class="progress-track" aria-label={`${categoryCopy[category].zh}本周进度`}>
						<span style={`--progress: ${percent}%`} />
					</div>
					<div class="weekly-note">
						<span
							data-bilingual="text"
							data-zh={remaining > 0 ? `本周再点亮 ${remaining} 天` : '本周目标已经完成'}
							data-en={remaining > 0 ? `${remaining} more day${remaining > 1 ? 's' : ''} this week` : 'Weekly goal complete'}
						>
							{remaining > 0 ? `本周再点亮 ${remaining} 天` : '本周目标已经完成'}
						</span>
						<small
							data-bilingual="text"
							data-zh={`最低行动 ${minimum} 分钟`}
							data-en={`Minimum ${minimum} min`}
						>
							最低行动 {minimum} 分钟
						</small>
					</div>
				</article>
			))
		}
	</div>

	<section class="calendar-card glass-card" aria-labelledby="lamp-calendar-title">
		<div class="calendar-heading">
			<div>
				<span class="calendar-kicker">LAMP CALENDAR</span>
				<h2 id="lamp-calendar-title" data-bilingual="text" data-zh="灯火日历" data-en="Lamp Calendar">
					灯火日历
				</h2>
			</div>
			<div class="lamp-legend" aria-label="图例">
				<span><i class="legend-lamp is-english" /><b data-bilingual="text" data-zh="英语" data-en="English">英语</b></span>
				<span><i class="legend-lamp is-exercise" /><b data-bilingual="text" data-zh="运动" data-en="Exercise">运动</b></span>
			</div>
		</div>

		<div class="month-switcher" role="tablist" aria-label="选择月份">
			{
				monthCalendars.map(({ monthKey, zhLabel, enLabel }, index) => (
					<button
						type="button"
						role="tab"
						class:list={{ 'is-active': index === 0 }}
						aria-selected={index === 0 ? 'true' : 'false'}
						data-month-target={monthKey}
						data-bilingual="text"
						data-zh={zhLabel}
						data-en={enLabel}
					>
						{zhLabel}
					</button>
				))
			}
		</div>

		{
			monthCalendars.map((calendar, index) => (
				<div class="month-panel" data-month-panel={calendar.monthKey} hidden={index !== 0}>
					<div class="calendar-weekdays" aria-hidden="true">
						{[
							['一', 'Mon'],
							['二', 'Tue'],
							['三', 'Wed'],
							['四', 'Thu'],
							['五', 'Fri'],
							['六', 'Sat'],
							['日', 'Sun'],
						].map(([zh, en]) => (
							<span data-bilingual="text" data-zh={zh} data-en={en}>{zh}</span>
						))}
					</div>
					<div class="calendar-grid">
						{Array.from({ length: calendar.leadingEmptyDays }, () => <span class="calendar-empty" />)}
						{calendar.dayCells.map(({ dayKey, dayNumber, summary, entryCount }) => (
							<button
								type="button"
								class:list={[
									'calendar-day',
									{
										'is-today': dayKey === todayKey,
										'has-entry': entryCount > 0,
									},
								]}
								data-entry-target={entryCount > 0 ? dayKey : undefined}
								aria-label={`${dayKey}，英语${summary.english.count > 0 ? '已完成' : '未完成'}，运动${summary.exercise.count > 0 ? '已完成' : '未完成'}`}
							>
								<span class="day-number">{dayNumber}</span>
								<span class="day-lamps" aria-hidden="true">
									<i class:list={['calendar-lamp', 'is-english', { 'is-lit': summary.english.count > 0 }]} />
									<i class:list={['calendar-lamp', 'is-exercise', { 'is-lit': summary.exercise.count > 0 }]} />
								</span>
								{entryCount > 0 && <small>{entryCount}</small>}
							</button>
						))}
					</div>
					<div class="month-stats">
						<div>
							<strong>{calendar.lights}</strong>
							<span data-bilingual="text" data-zh="点亮灯数" data-en="Lamps lit">点亮灯数</span>
						</div>
						<div>
							<strong>{calendar.activeDays}</strong>
							<span data-bilingual="text" data-zh="行动天数" data-en="Active days">行动天数</span>
						</div>
						<div>
							<strong>{calendar.minutes}</strong>
							<span data-bilingual="text" data-zh="记录分钟" data-en="Minutes logged">记录分钟</span>
						</div>
					</div>
				</div>
			))
		}
	</section>

	<div class="records-heading">
		<div>
			<span class="records-kicker">FIELD NOTES</span>
			<h2 data-bilingual="text" data-zh="所有记录" data-en="All Notes">所有记录</h2>
		</div>
		<p
			data-bilingual="text"
			data-zh={`本月已经行动 ${currentMonth.activeDays} 天，点亮 ${currentMonth.lights} 盏灯。`}
			data-en={`${currentMonth.activeDays} active days and ${currentMonth.lights} lamps lit this month.`}
		>
			本月已经行动 {currentMonth.activeDays} 天，点亮 {currentMonth.lights} 盏灯。
		</p>
	</div>

	<div class="checkin-board glass-card">
		<div class="board-topline">
			<span class="board-mark" aria-hidden="true">✓</span>
			<span data-copy="checkins.listTitle">全部记录</span>
			<span class="board-count">{String(checkins.length).padStart(2, '0')}</span>
		</div>
		<div class="checkin-list">
			{
				enrichedCheckins.map(({ checkin, dayKey, category }) => (
					<article
						class="checkin-entry"
						id={firstCheckinIdByDay.get(dayKey) === checkin.id
							? `checkin-day-${dayKey}`
							: `checkin-${checkin.id.replaceAll('/', '-')}`}
					>
						<time datetime={checkin.data.date.toISOString()}>{formatDate(checkin.data.date)}</time>
						<div class="checkin-content">
							<div class="entry-heading">
								<h3>{checkin.data.title}</h3>
								<span
									class:list={['category-badge', `is-${category}`]}
									data-bilingual="text"
									data-zh={categoryCopy[category].zh}
									data-en={categoryCopy[category].en}
								>
									{categoryCopy[category].zh}
								</span>
							</div>
							{checkin.data.summary && <p class="checkin-summary">{checkin.data.summary}</p>}
							{checkin.data.duration > 0 && (
								<div class="structured-summary">
									<span>{checkin.data.activity || categoryCopy[category].zh}</span>
									<strong>{checkin.data.duration} min</strong>
								</div>
							)}
							{renderedBodies.get(checkin.id) && (
								<div class="checkin-body prose prose-compact" set:html={renderedBodies.get(checkin.id)} />
							)}
							{checkin.data.items.length > 0 && (
								<dl class="checkin-details">
									{checkin.data.items.map((item) => (
										<div>
											<dt>{item.label}</dt>
											<dd>
												{item.href ? (
													<a href={item.href} target="_blank" rel="noreferrer">
														{item.value}<span aria-hidden="true"> ↗</span>
													</a>
												) : (
													item.value
												)}
											</dd>
										</div>
									))}
								</dl>
							)}
							<div class="checkin-tags">
								{checkin.data.tags.map((tag) => <span>#{getTagLabel(tag, tagMap)}</span>)}
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	const setupLampDashboard = () => {
		document
			.querySelectorAll<HTMLElement>('[data-lamp-dashboard]:not([data-ready])')
			.forEach((root) => {
				root.dataset.ready = 'true';
				const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-month-target]')];
				const panels = [...root.querySelectorAll<HTMLElement>('[data-month-panel]')];

				tabs.forEach((tab) => {
					tab.addEventListener('click', () => {
						const target = tab.dataset.monthTarget;
						tabs.forEach((candidate) => {
							const active = candidate === tab;
							candidate.classList.toggle('is-active', active);
							candidate.setAttribute('aria-selected', String(active));
						});
						panels.forEach((panel) => {
							panel.hidden = panel.dataset.monthPanel !== target;
						});
					});
				});

				root.querySelectorAll<HTMLButtonElement>('[data-entry-target]').forEach((day) => {
					day.addEventListener('click', () => {
						const target = document.getElementById(`checkin-day-${day.dataset.entryTarget}`);
						target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
					});
				});
			});
	};

	setupLampDashboard();
	document.addEventListener('astro:page-load', setupLampDashboard);
</script>

<style>
	.daily-checkins {
		padding: 3.4rem 0 3rem;
		animation: checkin-rise 720ms 180ms both;
	}

	.checkin-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 1.3rem;
	}

	.checkin-heading .section-title {
		margin-top: 0.45rem;
	}

	.checkin-intro {
		max-width: 37rem;
		margin: 0.8rem 0 0;
		color: var(--text-soft);
	}

	.today-state {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.8rem 1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-panel) 88%, transparent);
	}

	.today-date {
		display: grid;
		font-size: 0.72rem;
		color: var(--text-soft);
	}

	.today-date strong {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 0.95rem;
	}

	.today-lamps {
		display: flex;
		gap: 0.55rem;
	}

	.mini-lamp,
	.calendar-lamp,
	.legend-lamp,
	.action-lamp {
		display: inline-block;
		border-radius: 50%;
		background: color-mix(in srgb, var(--line) 82%, transparent);
		box-shadow: inset 0 -1px 2px rgba(0, 0, 0, 0.12);
	}

	.mini-lamp {
		width: 0.9rem;
		height: 0.9rem;
	}

	.is-english.is-lit,
	.quick-action.is-english .action-lamp,
	.legend-lamp.is-english {
		background: #e3a34f;
		box-shadow: 0 0 0 4px rgba(227, 163, 79, 0.11), 0 0 18px rgba(227, 163, 79, 0.62);
	}

	.is-exercise.is-lit,
	.quick-action.is-exercise .action-lamp,
	.legend-lamp.is-exercise {
		background: #4d9b91;
		box-shadow: 0 0 0 4px rgba(77, 155, 145, 0.1), 0 0 18px rgba(77, 155, 145, 0.54);
	}

	.quick-panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 2rem;
		padding: 1.5rem;
		border-radius: var(--radius-xl);
		background:
			radial-gradient(circle at 80% 0%, rgba(227, 163, 79, 0.12), transparent 34%),
			radial-gradient(circle at 94% 100%, rgba(77, 155, 145, 0.12), transparent 32%),
			var(--bg-panel);
	}

	.quick-kicker,
	.calendar-kicker,
	.records-kicker,
	.habit-label {
		color: var(--text-soft);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.quick-copy h2,
	.calendar-heading h2,
	.records-heading h2,
	.weekly-card h2 {
		margin: 0.28rem 0 0;
		font-family: var(--font-serif);
		letter-spacing: -0.035em;
	}

	.quick-copy h2 {
		font-size: clamp(1.4rem, 2.6vw, 2rem);
	}

	.quick-copy p {
		margin: 0.38rem 0 0;
		color: var(--text-soft);
	}

	.quick-actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(9rem, 1fr));
		gap: 0.7rem;
	}

	.quick-action {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.8rem;
		min-width: 9rem;
		padding: 0.95rem 1rem;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: color-mix(in srgb, var(--bg-panel) 88%, transparent);
		transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
	}

	.quick-action:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--accent) 38%, var(--line));
		box-shadow: 0 14px 30px rgba(45, 67, 87, 0.1);
	}

	.action-lamp {
		width: 1rem;
		height: 1rem;
	}

	.quick-action strong,
	.quick-action small {
		display: block;
	}

	.quick-action strong {
		font-size: 0.92rem;
	}

	.quick-action small {
		margin-top: 0.12rem;
		color: var(--text-soft);
		font-size: 0.72rem;
	}

	.weekly-grid {
		display: grid;
