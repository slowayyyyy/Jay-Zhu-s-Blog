---
import { siteConfig } from '../data/site';

interface Props {
	pathname: string;
}

const { pathname } = Astro.props;

const items = [
	{ href: '/', key: 'nav.home' },
	{ href: '/search/', key: 'nav.search' },
	{ href: '/life/', key: 'nav.life' },
	{ href: '/checkins/', key: 'nav.checkins' },
	{ href: '/about/', key: 'nav.about' },
];
---

<header class="site-header" data-site-header>
	<div class="container header-inner">
		<a class="brand" href="/" aria-label={`${siteConfig.name} 首页`}>
			<span class="brand-mark" aria-hidden="true">J</span>
			<span class="brand-copy">
				<strong class="brand-name">{siteConfig.name}</strong>
				<span class="brand-sub">{siteConfig.brandSubtitle}</span>
			</span>
		</a>

		<button
			type="button"
			class="menu-toggle"
			data-menu-toggle
			aria-expanded="false"
			aria-controls="site-navigation"
			aria-label="打开导航菜单"
		>
			<span aria-hidden="true" />
			<span aria-hidden="true" />
		</button>

		<div class="primary-navigation" id="site-navigation" data-primary-navigation>
			<nav aria-label="Primary">
				<ul class="nav-list">
					{
						items.map((item) => (
							<li>
								<a
									href={item.href}
									class:list={[
										'nav-link',
										pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href))
											? 'is-active'
											: '',
									]}
									aria-current={
										pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href))
											? 'page'
											: undefined
									}
									data-copy={item.key}
								/>
							</li>
						))
					}
					<li><a class="nav-link" href="/rss.xml" data-copy="nav.rss" /></li>
				</ul>
			</nav>

			<div class="header-controls">
				<button type="button" class="control-button" data-theme-toggle aria-label="切换明暗模式">
					<span data-copy="controls.theme" />
				</button>
				<button type="button" class="control-button" data-language-toggle aria-label="切换中英文">
					<span aria-hidden="true">中 / EN</span>
				</button>
			</div>
		</div>
	</div>
</header>

<script is:inline data-astro-rerun>
	(() => {
		const header = document.querySelector('[data-site-header]');
		if (!(header instanceof HTMLElement) || header.dataset.menuReady === 'true') return;
		header.dataset.menuReady = 'true';

		const toggle = header.querySelector('[data-menu-toggle]');
		const navigation = header.querySelector('[data-primary-navigation]');
		if (!(toggle instanceof HTMLButtonElement) || !(navigation instanceof HTMLElement)) return;

		const setOpen = (open) => {
			navigation.classList.toggle('is-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
		};

		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
		header.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			setOpen(false);
			toggle.focus();
		});
		navigation.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		padding: 0.65rem 0 0;
	}

	.header-inner {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 1.2rem;
		min-height: 4.5rem;
		padding: 0.55rem 0.7rem 0.55rem 0.8rem;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: var(--bg);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 2.45rem;
		height: 2.45rem;
		border-radius: 0.25rem;
		background: var(--text);
		color: var(--bg);
		font-family: var(--font-serif);
		font-size: 1.25rem;
		line-height: 1;
	}

	.brand-copy {
		display: grid;
		min-width: 0;
	}

	.brand-name {
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.1;
		white-space: nowrap;
	}

	.brand-sub {
		margin-top: 0.2rem;
		color: var(--text-soft);
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.primary-navigation {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
	}

	.nav-list {
		display: flex;
		justify-content: center;
		gap: 0.2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav-link,
	.control-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		padding: 0.55rem 0.78rem;
		border: 0;
		border-bottom: 1px solid transparent;
		border-radius: 0;
		background: transparent;
		color: var(--text-soft);
		font-size: 0.86rem;
		transition: color var(--transition), border-color var(--transition);
	}

	.nav-link:hover,
	.nav-link.is-active {
		border-bottom-color: var(--accent);
		color: var(--text);
	}

	.header-controls {
		display: flex;
		gap: 0.2rem;
		padding-left: 0.45rem;
		border-left: 1px solid var(--line);
	}

	.control-button:hover {
		color: var(--accent);
	}

	.menu-toggle {
		display: none;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--text);
	}

	.menu-toggle span {
		position: absolute;
		width: 1.1rem;
		height: 1px;
		background: currentColor;
		transition: transform var(--transition);
	}

	.menu-toggle span:first-child { transform: translateY(-0.22rem); }
	.menu-toggle span:last-child { transform: translateY(0.22rem); }
	.menu-toggle[aria-expanded='true'] span:first-child { transform: rotate(45deg); }
	.menu-toggle[aria-expanded='true'] span:last-child { transform: rotate(-45deg); }

	@media (max-width: 940px) {
		.site-header { padding-top: 0.4rem; }

		.header-inner {
			grid-template-columns: minmax(0, 1fr) auto;
			min-height: 3.8rem;
			padding: 0.45rem 0.5rem 0.45rem 0.65rem;
		}

		.brand-mark {
			width: 2.25rem;
			height: 2.25rem;
		}

		.brand-sub { display: none; }
		.menu-toggle { display: grid; }

		.primary-navigation {
			position: absolute;
			top: calc(100% + 0.45rem);
			right: 0;
			left: 0;
			display: none;
			gap: 0.7rem;
			padding: 0.7rem;
			border: 1px solid var(--line);
			border-radius: var(--radius-sm);
			background: var(--bg);
			box-shadow: 0 20px 48px rgba(30, 48, 62, 0.16);
		}

		.primary-navigation.is-open { display: grid; }

		.nav-list {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0;
		}

		.nav-link {
			justify-content: flex-start;
			min-height: 3rem;
			padding-inline: 0.8rem;
			border-bottom-color: var(--line);
		}

		.nav-link.is-active { color: var(--accent); }

		.header-controls {
			justify-content: flex-end;
			padding: 0.2rem 0 0;
			border-left: 0;
		}
	}
</style>
