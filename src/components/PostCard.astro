---
import {
	estimateReadingMinutes,
	formatDate,
	getPostSlug,
	getSectionInfo,
	getTagLabel,
	getTagMap,
	type PostEntry,
} from '../lib/content';

interface Props {
	post: PostEntry;
	headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const section = getSectionInfo(post.data.section);
const readingMinutes = estimateReadingMinutes(post);
const slug = getPostSlug(post);
const tagMap = await getTagMap();
---

<article class="post-card" style={`--post-accent:${section.accent};`}>
	<div class="post-rail">
		<time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
		<a class="post-section" href={`/search/?section=${post.data.section}`}>
			<span data-copy={`section.${post.data.section}`}>{section.zh}</span>
		</a>
	</div>

	<div class="post-content">
		<Heading class="post-title"><a href={`/posts/${slug}/`}>{post.data.title}</a></Heading>
		<p class="post-description">{post.data.excerpt}</p>
		<div class="post-meta">
			<span class="reading-time">{readingMinutes} min</span>
			<div class="post-tags">
				{
					post.data.tags.slice(0, 3).map((tag) => (
						<a class="tag-link" href={`/search/?tag=${encodeURIComponent(tag)}`}>
							#{getTagLabel(tag, tagMap)}
						</a>
					))
				}
			</div>
		</div>
	</div>

	<a class="read-link" href={`/posts/${slug}/`} data-copy="common.readMore" />
</article>

<style>
	.post-card {
		position: relative;
		display: grid;
		grid-template-columns: 8.5rem minmax(0, 1fr) auto;
		gap: 1.25rem;
		align-items: start;
		padding: 1.6rem 0.3rem;
		border-top: 1px solid var(--line);
		transition: background var(--transition), padding var(--transition);
	}

	.post-card::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		width: 3rem;
		height: 1px;
		background: var(--post-accent);
		transform-origin: left;
		transition: transform var(--transition);
	}

	.post-card:hover {
		padding-inline: 0.75rem;
		background: color-mix(in srgb, var(--bg-panel) 72%, transparent);
	}

	.post-card:hover::before { transform: scaleX(1.66); }

	.post-rail {
		display: grid;
		gap: 0.6rem;
		color: var(--text-soft);
		font-size: 0.76rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
	}

	.post-section {
		position: relative;
		justify-self: start;
		padding-left: 0.75rem;
		color: color-mix(in srgb, var(--post-accent) 78%, var(--text));
	}

	.post-section::before {
		content: '';
		position: absolute;
		top: 0.25em;
		bottom: 0.25em;
		left: 0;
		width: 1px;
		background: var(--post-accent);
	}

	.post-title {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.5vw, 1.9rem);
		line-height: 1.18;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.post-title a {
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: color var(--transition), text-decoration-color var(--transition);
	}

	.post-title a:hover {
		color: var(--accent);
		text-decoration-color: currentColor;
	}

	.post-description {
		max-width: 46rem;
		margin: 0.65rem 0 0;
		color: var(--text-soft);
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem 1rem;
		margin-top: 0.9rem;
		color: var(--text-soft);
		font-size: 0.78rem;
	}

	.reading-time {
		padding-right: 1rem;
		border-right: 1px solid var(--line);
		font-variant-numeric: tabular-nums;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.8rem;
	}

	.tag-link {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		color: var(--text-soft);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
	}

	.tag-link:hover {
		color: var(--accent);
		text-decoration-color: currentColor;
	}

	.read-link {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		color: var(--accent);
		font-size: 0.84rem;
		white-space: nowrap;
	}

	.read-link::after {
		content: '';
		width: 0.48rem;
		height: 0.48rem;
		margin-left: 0.45rem;
		border-top: 1px solid currentColor;
		border-right: 1px solid currentColor;
		transform: rotate(45deg);
		transition: transform var(--transition);
	}

	.read-link:hover::after { transform: translateX(0.2rem) rotate(45deg); }

	@media (max-width: 720px) {
		.post-card {
			grid-template-columns: 1fr auto;
			gap: 0.75rem 1rem;
			padding: 1.35rem 0.2rem;
		}

		.post-card:hover { padding-inline: 0.2rem; }

		.post-rail {
			grid-column: 1 / -1;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.post-content { grid-column: 1 / -1; }
		.read-link { grid-column: 1; justify-self: start; }
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card:hover { padding-inline: 0.3rem; }
	}
</style>
