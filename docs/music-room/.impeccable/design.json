      "html": "<a class=\"ds-room-entry\" href=\"/music/room/\"><span><strong class=\"ds-room-entry-title\">进入聆听室</strong><small class=\"ds-room-entry-copy\">展开唱片、歌词与收藏，在这里慢慢听。</small></span><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M5 5v2h10.6L5 17.6 6.4 19 17 8.4V19h2V5z\"/></svg></a>",
      "css": ".ds-room-entry{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.15rem;border:1px solid var(--line-divider,rgba(0,0,0,.08));border-radius:8px;background:color-mix(in srgb,var(--primary,#167eb3) 5%,var(--card-bg,white));color:var(--content-regular,rgba(0,0,0,.9));font-family:var(--font-sans,serif);text-decoration:none}.ds-room-entry-title{font-size:1rem;font-weight:600}.ds-room-entry-copy{display:block;margin-top:.3rem;font-size:.75rem;line-height:1.7;color:var(--content-meta,rgba(0,0,0,.7))}.ds-room-entry>svg{flex-shrink:0;color:var(--primary,#167eb3)}.ds-room-entry:focus-visible{outline:2px solid var(--room-accent,#167eb3);outline-offset:4px}"
    },
