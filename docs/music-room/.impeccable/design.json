      "html": "<button class=\"ds-room-ghost\" aria-label=\"下一首\"><svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"m6 18 8.5-6L6 6zm10-12v12h2V6z\"/></svg></button>",
      "css": ".ds-room-ghost{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:.5rem;border:0;background:transparent;color:var(--room-accent,#167eb3);transition:color .15s}.ds-room-ghost:hover{color:var(--room-accent,#167eb3)}.ds-room-ghost:active{transform:scale(.95)}.ds-room-ghost:focus-visible{outline:2px solid var(--room-accent,#167eb3);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-room-ghost{transition:none}}"
    },
